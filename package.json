{
  "name": "MM Astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync-datocms": "node scripts/sync-datocms.mjs",
    "dev": "npm run sync-datocms && astro dev",
    "check:cache-tags": "node --import tsx --import ./scripts/revalidation-map/sentinel.mjs scripts/cache-tags/check.ts",
    "check:revalidation-map": "node --import tsx --import ./scripts/revalidation-map/sentinel.mjs scripts/revalidation-map/check.ts",
    "docs:inventory": "node scripts/check-docs-inventory.mjs",
    "start": "npm run sync-datocms && astro dev",
    "bundle-search-client": "node scripts/build-search-client.mjs",
    "prebuild": "npm run bundle-search-client",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-schema": "npx datocms schema:generate schema.ts",
    "format": "npx prettier --write --ignore-path .prettierignore .",
    "test": "npm run format && npm run lint && npm run build",
    "lint": "prettier --check --ignore-path .prettierignore .",
    "build:cf": "npm run bundle-search-client && DEPLOY_TARGET=cloudflare astro build",
    "deploy:cf": "npm run build:cf && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/vercel": "^11.0.20",
    "@datocms/astro": "^0.6.16",
    "@datocms/cda-client": "^0.3.2",
    "@datocms/cma-client": "^6.8.0",
    "@datocms/content-link": "^0.3.23",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "4.2.1",
    "linkedom": "^0.18.15",
    "maplibre-gl": "6.17.0",
    "serialize-error": "^13.1.0",
    "swiper": "14.4.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@types/jsonwebtoken": "^9.0.10",
    "datocms": "^4.2.0",
    "dotenv-cli": "^11.1.0",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "wrangler": "^4.147.0"
  }
}
