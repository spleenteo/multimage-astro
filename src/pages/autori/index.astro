---
// /autori: every author with books, A–Z. A slim title row (as on /libri and /collane), a search
// that also knows legal names and aliases, a flat letter index, then per letter a grid of flat
// author cards. The server renders the first letters (AUTHORS_SERVER_LETTERS); the browser adds
// the others from `/authors-index.json` once the page is idle (`index/_index.client.ts`), so
// readers without JavaScript and crawlers get those letters, and the sitemap lists everyone.
import BaseLayout from '~/layouts/BaseLayout.astro';
import AuthorCard from '~/components/AuthorCard';
import { toPlainText } from '~/lib/text';
import { withFallbackSeo } from '~/lib/seo';
import {
  AUTHORS_INDEX_URL,
  AUTHORS_SERVER_LETTERS,
  AUTHORS_SERVER_READ,
  type AuthorIndexItem,
} from '~/lib/authorIndex';
import styles from './index/_style.module.css';
import { AUTHORS_PAGE_QUERY } from './index/_graphql';
import { authorsPageVariables, readAuthorsIndex } from './index/_data';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { resolveDraftMode } from '~/lib/draftPreview';

const draftModeEnabled = resolveDraftMode(Astro);
const { indexContent, items, letters, booksInCatalogue } = await readAuthorsIndex(
  draftModeEnabled,
  AUTHORS_SERVER_READ,
);

const title = indexContent?.title?.trim() || 'Autrici e autori';
const introHtml = indexContent?.subtitle?.trim() || null;
const seo = withFallbackSeo(indexContent?._seoMetaTags, {
  title,
  description: introHtml ? toPlainText(introHtml) : undefined,
});

// The letters rendered here; the rest of the alphabet arrives with the JSON.
const authors = items.filter((author) => AUTHORS_SERVER_LETTERS.includes(author.l));
type Group = { letter: string; anchorId: string; authors: AuthorIndexItem[] };
const groupsMap = new Map<string, Group>();
for (const author of authors) {
  if (!groupsMap.has(author.l)) {
    groupsMap.set(author.l, { letter: author.l, anchorId: author.a, authors: [] });
  }
  groupsMap.get(author.l)!.authors.push(author);
}
const groups = [...groupsMap.values()];

const authorsWithBooks = letters.reduce((total, entry) => total + entry.count, 0);
const sizeLine = `${authorsWithBooks} autrici e autori · ${booksInCatalogue} libri in catalogo`;
// A card with every optional part, as a mould for the cards the browser builds.
const mould = (portrait: boolean): AuthorIndexItem => ({
  k: '-',
  l: '-',
  a: '-',
  n: '-',
  ln: '-',
  sz: '-',
  b: '-',
  i: '-',
  h: '/libri',
  cv: [{ src: 'data:,', width: 39, height: 56 }],
  s: '',
  ...(portrait ? { p: 'data:,' } : {}),
});
---

<BaseLayout seo={seo}>
  <div class={styles.page} data-authors-index data-index-url={AUTHORS_INDEX_URL}>
    <script is:inline>
      document.documentElement.classList.add('authors-js');
    </script>
    <header class={styles.intro}>
      <h1 class={styles.title}>{title}</h1>
      {authorsWithBooks > 0 ? <p class={styles.size}>{sizeLine}</p> : null}
      {introHtml ? <div class={styles.lede} set:html={introHtml} /> : null}
    </header>

    {authorsWithBooks === 0 ? (
      <div class={styles.empty}>
        <p>Non ci sono ancora autrici e autori da mostrare. Tutti i libri sono nel catalogo.</p>
        <a href="/libri">Sfoglia il catalogo</a>
      </div>
    ) : (
      <>
        <div class={styles.tools}>
          <label class={styles.search}>
            <iconify-icon
              icon="iconoir:search"
              width="18"
              height="18"
              aria-hidden="true"
            ></iconify-icon>
            <span class="sr-only">Cerca autrici e autori per nome o alias</span>
            <input
              id="author-search"
              type="search"
              placeholder="Cerca per nome o alias"
              autocomplete="off"
            />
          </label>
          <p id="author-results" class={styles.results} role="status" aria-live="polite"></p>
        </div>

        <nav
          id="indice-autori"
          class={styles.letters}
          aria-label="Indice alfabetico di autrici e autori"
          data-author-nav
        >
          {/* Every letter of the index; the ones whose authors arrive with the JSON are marked. */}
          {letters.map(({ letter, anchorId }) => <a
            href={`#${anchorId}`}
            data-nav-anchor={anchorId}
            data-nav-pending={groupsMap.has(letter) ? undefined : ''}
            >{letter}</a
          >)}
        </nav>

        <div id="author-no-results" class={styles.noResults} hidden>
          <p class={styles.noResultsTitle}>Nessuna autrice o autore con questo nome</p>
          <p>
            Prova con il cognome o con un alias, oppure{' '}
            <a id="author-search-site" href="/cerca">cerca in tutto il sito</a>.
          </p>
        </div>

        <div class={styles.groups} data-author-groups>
          {groups.map(({ letter, anchorId, authors: groupAuthors }) => <section
            id={anchorId}
            class={styles.group}
            data-author-group
            aria-labelledby={`${anchorId}-title`}
          >
            <h2 id={`${anchorId}-title`} class={styles.groupTitle}>{letter}</h2>
            <div class={styles.grid}>
              {groupAuthors.map((author) => <div
                data-author-card
                data-key={author.k}
                data-search={author.s}
              >
                <AuthorCard author={author} />
              </div>)}
            </div>
          </section>)}
        </div>

        {/* Moulds for the letters and cards the browser builds from the JSON. */}
        <template data-group-template>
          <section class={styles.group} data-author-group>
            <h2 class={styles.groupTitle}></h2>
            <div class={styles.grid}></div>
          </section>
        </template>
        <template data-card-template>
          <div data-author-card><AuthorCard author={mould(true)} /></div>
        </template>
        <template data-card-template-initial>
          <div data-author-card><AuthorCard author={mould(false)} /></div>
        </template>
      </>
    )}

    <p class={styles.publish}>
      Vuoi pubblicare con Multimage?{' '}
      <a href="/info/chi-siamo">Scopri come proporre la tua opera alla redazione</a>.
    </p>
  </div>
  <DraftModeQueryListener
    query={AUTHORS_PAGE_QUERY}
    variables={authorsPageVariables(AUTHORS_SERVER_READ)}
  />
</BaseLayout>

<script is:inline>
  (function () {
    var input = document.getElementById('author-search');
    var noResults = document.getElementById('author-no-results');
    var status = document.getElementById('author-results');
    var siteSearch = document.getElementById('author-search-site');
    if (!input) return;

    function normalize(s) {
      return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }

    function filter() {
      var raw = input.value.trim();
      var query = normalize(raw);
      var terms = query.split(/\s+/).filter(Boolean);
      var total = 0;

      document.querySelectorAll('[data-author-group]').forEach(function (group) {
        var visibleInGroup = 0;
        group.querySelectorAll('[data-author-card]').forEach(function (card) {
          var text = normalize(card.dataset.search || '');
          var visible = terms.every(function (term) {
            return text.indexOf(term) !== -1;
          });
          card.hidden = !visible;
          if (visible) visibleInGroup++;
        });
        group.hidden = visibleInGroup === 0;
        total += visibleInGroup;
        var anchor = document.querySelector('[data-nav-anchor="' + group.id + '"]');
        if (anchor) anchor.hidden = visibleInGroup === 0;
      });

      // Until the other letters arrive, an empty result only means "not here yet".
      var root = document.querySelector('[data-authors-index]');
      var pending =
        root && root.dataset.indexState !== 'loaded' && root.dataset.indexState !== 'failed';
      if (noResults) noResults.hidden = !(terms.length > 0 && total === 0 && !pending);
      if (siteSearch) siteSearch.href = raw ? '/cerca?q=' + encodeURIComponent(raw) : '/cerca';
      if (status) {
        status.textContent =
          terms.length === 0
            ? ''
            : pending
              ? 'Cerco tra tutte le autrici e gli autori…'
              : total === 1
                ? '1 risultato'
                : total + ' risultati';
      }
    }

    input.addEventListener('input', filter);
    // The other letters arrive from the JSON after load: apply the current search to them too.
    document.addEventListener('authors:loaded', filter);
  })();
</script>

<script>
  import { initAuthorsIndex } from './index/_index.client';

  document.querySelectorAll<HTMLElement>('[data-authors-index]').forEach(initAuthorsIndex);
</script>
