---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BannerSection from '~/components/BannerSection';
import FeaturedBookHighlight from '~/components/FeaturedBookHighlight';
import BookCarouselSection from '~/components/BookCarouselSection';
import PillsBlock from '~/components/blocks/PillsBlock';
import HomeHero from '~/components/HomeHero';
import HomeDoors, { onlyRepeatsDoors } from '~/components/HomeDoors';
import HomeAbout from '~/components/HomeAbout';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { withFallbackSeo } from '~/lib/seo';
import { toPlainText, toRichTextHtml } from '~/lib/text';
import { toBookCard, formatBookPrice, mapBooksToCards } from '~/lib/books';
import { formatAuthorNames, getAuthorDisplayName } from '~/lib/authors';
import type { BookCardViewModel } from '~/lib/books';
import type { AssetColor, ResponsiveImage } from '~/lib/datocms/types';
import CtaButtonWithImageBlock from '~/components/datocms/structuredText/blocks/CtaButtonWithImageBlock.astro';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { resolveDraftMode } from '~/lib/draftPreview';
import {
  HOME_PAGE_QUERY,
  type HomeBannerBannerBlockRecord,
  type HomeSingleBookBlockRecord,
  type HomeCtaButtonBlockRecord,
  type HomeBookCarouselBlockRecord,
  type HomeBannerBlockRecord,
  type HomePageQueryResult,
  type HomePillsBlockRecord,
  type HighlightBookRecord,
  HOME_FEATURED_BOOK_QUERY,
  type HomeFeaturedBookQueryResult,
  LATEST_BOOK_QUERY,
  type LatestBookQueryResult,
} from './index/_graphql';

const draftModeEnabled = resolveDraftMode(Astro);

type HomeBannerSectionData = {
  id: string;
  title: string | null;
  contentHtml: string | null;
  link: string | null;
  imagePosition: 'left' | 'right';
  image: (ResponsiveImage & { title?: string | null }) | null;
  colors: AssetColor[] | null;
};

type HomeSingleBookHighlightData = {
  book: {
    title: string;
    subtitle?: string | null;
    summary?: string | null;
    priceLabel?: string | null;
    format?: string | null;
    printYear?: string | null;
    isArchived?: boolean;
    link: string;
    authorsLabel?: string | null;
    epubUrl?: string | null;
  };
  authors: Array<{ name: string; link: string | null }>;
  coverImage: (ResponsiveImage & { title?: string | null }) | null;
  coverColors: AssetColor[] | null;
  collectionLabel: string | null;
  collectionHref: string | null;
  label: string | null;
  author: {
    name: string;
    slug?: string | null;
    link?: string | null;
    booksCount?: number | null;
    picture?: ResponsiveImage | null;
    pictureAlt?: string | null;
  } | null;
};

type HomeBookCarouselData = {
  id: string;
  title: string;
  description?: string | null;
  books: BookCardViewModel[];
};

type HomePillButton = {
  id: string;
  label: string | null;
  url: string | null;
  primary: boolean | null;
} | null;

type HomePillItem = {
  id: string;
  icon: string | null;
  title: string | null;
  content: string | null;
  button: HomePillButton;
};

type HomePillsBlockData = {
  id: string;
  title: string | null;
  description: string | null;
  pills: HomePillItem[];
};

type HomeBannerEntry =
  | { kind: 'banner'; id: string; data: HomeBannerSectionData }
  | { kind: 'singleBook'; id: string; data: HomeSingleBookHighlightData }
  | { kind: 'bookCarousel'; id: string; data: HomeBookCarouselData }
  | { kind: 'cta'; id: string; block: HomeCtaButtonBlockRecord }
  | { kind: 'pills'; id: string; data: HomePillsBlockData };

function toHighlightData(
  record: HighlightBookRecord,
  label: string,
): HomeSingleBookHighlightData | null {
  const card = toBookCard(record);
  if (!card) {
    return null;
  }

  const collectionName = record.collection?.name?.trim() ?? null;
  const collectionSlug = record.collection?.slug?.trim() ?? null;
  const responsiveImage = record.coverImage?.responsiveImage ?? null;
  const fallbackAlt = record.coverImage?.alt?.trim() ?? card.title;
  const fallbackTitle = record.coverImage?.title?.trim() ?? fallbackAlt;
  const primaryAuthor = record.authors?.[0] ?? null;
  const primaryAuthorName = primaryAuthor ? getAuthorDisplayName(primaryAuthor) : null;

  return {
    book: {
      title: card.title,
      subtitle: card.subtitle ?? null,
      summary: card.summary ?? undefined,
      priceLabel: formatBookPrice(card.price ?? null) ?? undefined,
      format: card.format?.trim() ?? undefined,
      printYear: card.printYear ?? undefined,
      isArchived: card.isArchived,
      link: `/libri/${card.slug}`,
      authorsLabel: formatAuthorNames(card.authors ?? []),
      epubUrl: record.epubUrl?.trim() || null,
    },
    authors: (record.authors ?? []).flatMap((author) => {
      const name = getAuthorDisplayName(author);
      return name ? [{ name, link: author.slug ? `/autori/${author.slug}` : null }] : [];
    }),
    coverImage: responsiveImage
      ? {
          ...responsiveImage,
          alt: responsiveImage.alt ?? fallbackAlt,
          title: responsiveImage.title ?? fallbackTitle,
        }
      : null,
    coverColors: record.coverImage?.colors ?? null,
    collectionLabel: collectionName ? `Collana ${collectionName}` : null,
    collectionHref: collectionSlug ? `/collane/${collectionSlug}` : null,
    label,
    author:
      primaryAuthor && primaryAuthorName
        ? {
            name: primaryAuthorName,
            slug: primaryAuthor.slug ?? null,
            link: primaryAuthor.slug ? `/autori/${primaryAuthor.slug}` : null,
            booksCount: null,
            picture: primaryAuthor.picture?.responsiveImage ?? null,
            pictureAlt: primaryAuthor.picture?.alt ?? primaryAuthor.fullName ?? primaryAuthorName,
          }
        : null,
  };
}

const { home } = await executeQuery<HomePageQueryResult>(HOME_PAGE_QUERY, {
  includeDrafts: draftModeEnabled,
});

const defaultTitle = 'La casa editrice dei diritti umani';
const heroTitle = home?.title?.trim() || defaultTitle;
const heroClaimText = toPlainText(toRichTextHtml(home?.claim) ?? '');

const bannerBlocks: HomeBannerBlockRecord[] = home?.banners ?? [];
const homeBannerEntries = bannerBlocks
  .map<HomeBannerEntry | null>((block) => {
    if (block?.__typename === 'BannerRecord') {
      const bannerBlock = block as HomeBannerBannerBlockRecord;
      const trimmedTitle = bannerBlock.title?.trim() ?? null;
      const contentHtml = toRichTextHtml(bannerBlock.content) ?? null;
      const link = bannerBlock.link?.trim() ?? null;
      const position = bannerBlock.imagePosition === 'left' ? 'left' : 'right';
      const featuredImage = bannerBlock.featuredImage ?? null;
      const responsiveImage = featuredImage?.responsiveImage ?? null;
      const fallbackAlt = featuredImage?.alt?.trim() ?? trimmedTitle ?? 'Illustrazione';
      const fallbackTitle = featuredImage?.title?.trim() ?? trimmedTitle ?? fallbackAlt;
      const image = responsiveImage
        ? {
            ...responsiveImage,
            alt: responsiveImage.alt ?? fallbackAlt,
            title: responsiveImage.title ?? fallbackTitle,
          }
        : null;

      return {
        kind: 'banner',
        id: bannerBlock.id,
        data: {
          id: bannerBlock.id,
          title: trimmedTitle,
          contentHtml,
          link,
          imagePosition: position,
          image,
          colors: featuredImage?.colors ?? null,
        },
      } satisfies HomeBannerEntry;
    }

    if (block?.__typename === 'SingleBookRecord') {
      const singleBookBlock = block as HomeSingleBookBlockRecord;
      const data = singleBookBlock.book
        ? toHighlightData(singleBookBlock.book, 'Libro consigliato')
        : null;
      if (!data) {
        return null;
      }

      return { kind: 'singleBook', id: singleBookBlock.id, data } satisfies HomeBannerEntry;
    }

    if (block?.__typename === 'BookCarouselRecord') {
      const carouselBlock = block as HomeBookCarouselBlockRecord;
      const cards = mapBooksToCards(carouselBlock.books ?? []);
      if (cards.length === 0) {
        return null;
      }

      const resolvedTitle = carouselBlock.title?.trim() || 'Libri consigliati';
      const resolvedDescription = carouselBlock.description?.trim() ?? null;

      return {
        kind: 'bookCarousel',
        id: carouselBlock.id,
        data: {
          id: carouselBlock.id,
          title: resolvedTitle,
          description: resolvedDescription,
          books: cards,
        },
      } satisfies HomeBannerEntry;
    }

    if (block?.__typename === 'PillsBlockRecord') {
      const pillsBlock = block as HomePillsBlockRecord;
      const rawPills = pillsBlock.pillsBlock ?? [];
      const pills = rawPills.reduce<HomePillItem[]>((acc, pill) => {
        if (!pill || pill.__typename !== 'SingleInfoBlockRecord') {
          return acc;
        }

        const buttonRecord =
          pill.button && pill.button.__typename === 'ButtonRecord' ? pill.button : null;

        acc.push({
          id: pill.id,
          icon: pill.icon ?? null,
          title: pill.title ?? null,
          content: pill.content ?? null,
          button: buttonRecord
            ? {
                id: buttonRecord.id,
                label: buttonRecord.label ?? null,
                url: buttonRecord.url ?? null,
                primary: buttonRecord.primary ?? null,
              }
            : null,
        });

        return acc;
      }, []);

      if (pills.length < 2) {
        return null;
      }

      return {
        kind: 'pills',
        id: pillsBlock.id,
        data: {
          id: pillsBlock.id,
          title: pillsBlock.title,
          description: pillsBlock.description,
          pills,
        },
      } satisfies HomeBannerEntry;
    }

    if (block?.__typename === 'CtaButtonWithImageRecord') {
      return {
        kind: 'cta',
        id: block.id,
        block: block as HomeCtaButtonBlockRecord,
      } satisfies HomeBannerEntry;
    }

    return null;
  })
  .filter((entry): entry is HomeBannerEntry => entry !== null);

// Hero book: the CMS field "Libro del momento", else the first "libro in evidenza" block (which
// then leaves the list), else the latest book. The field query fails until the migration runs on
// the environment; that is expected and only means "no field yet".
let featuredRecord: HighlightBookRecord | null = null;
try {
  const featured = await executeQuery<HomeFeaturedBookQueryResult>(HOME_FEATURED_BOOK_QUERY, {
    includeDrafts: draftModeEnabled,
  });
  featuredRecord = featured.home?.featuredBook ?? null;
} catch {
  featuredRecord = null;
}

let heroBook: HomeSingleBookHighlightData | null = featuredRecord
  ? toHighlightData(featuredRecord, 'Libro del momento')
  : null;
let heroBlockId: string | null = null;

if (!heroBook) {
  const firstSingleBook = homeBannerEntries.find((entry) => entry.kind === 'singleBook');
  if (firstSingleBook?.kind === 'singleBook') {
    heroBook = firstSingleBook.data;
    heroBlockId = firstSingleBook.id;
  }
}

if (!heroBook) {
  const latest = await executeQuery<LatestBookQueryResult>(LATEST_BOOK_QUERY, {
    includeDrafts: draftModeEnabled,
  });
  const latestRecord = latest.allBooks?.[0] ?? null;
  heroBook = latestRecord ? toHighlightData(latestRecord, 'Libro del momento') : null;
}

// Fixed top: the first carousel follows the doors; the rest keeps the editors' order.
const firstCarousel = homeBannerEntries.find((entry) => entry.kind === 'bookCarousel') ?? null;
// A pills block whose buttons only lead to catalogue, authors and collections repeats HomeDoors.
const repeatsDoors = (entry: HomeBannerEntry) =>
  entry.kind === 'pills' && onlyRepeatsDoors(entry.data.pills.map((pill) => pill.button?.url));
const freeEntries = homeBannerEntries.filter(
  (entry) => entry !== firstCarousel && entry.id !== heroBlockId && !repeatsDoors(entry),
);

const seo = withFallbackSeo(home?._seoMetaTags, {
  title: heroTitle.includes('Multimage') ? heroTitle : `${heroTitle} | Multimage`,
  description: heroClaimText,
});
---

<BaseLayout seo={seo}>
  <div class="space-y-12">
    {heroBook ? (
      <HomeHero
        pageTitle={heroTitle}
        book={heroBook.book}
        authors={heroBook.authors}
        coverImage={heroBook.coverImage}
        coverColors={heroBook.coverColors}
        collectionLabel={heroBook.collectionLabel}
        collectionHref={heroBook.collectionHref}
      />
    ) : (
      <h1 class="text-3xl md:text-4xl">{heroTitle}</h1>
    )}

    <HomeDoors />

    {firstCarousel?.kind === 'bookCarousel' ? (
      <BookCarouselSection
        id={firstCarousel.data.id}
        title={firstCarousel.data.title}
        description={firstCarousel.data.description}
        books={firstCarousel.data.books}
      />
    ) : null}

    {freeEntries.length > 0 ? (
      <div class="v3-space-y-10">
        {freeEntries.map((entry) => {
          if (entry.kind === 'banner') {
            return <BannerSection {...entry.data} />;
          }

          if (entry.kind === 'singleBook') {
            return (
              <FeaturedBookHighlight
                book={entry.data.book}
                coverImage={entry.data.coverImage}
                collectionLabel={entry.data.collectionLabel ?? undefined}
                collectionHref={entry.data.collectionHref ?? undefined}
                label={entry.data.label ?? undefined}
                author={entry.data.author ?? undefined}
                coverColors={entry.data.coverColors}
              />
            );
          }

          if (entry.kind === 'bookCarousel') {
            return (
              <BookCarouselSection
                id={entry.data.id}
                title={entry.data.title}
                description={entry.data.description}
                books={entry.data.books}
              />
            );
          }

          if (entry.kind === 'cta') {
            return (
              <CtaButtonWithImageBlock
                block={{
                  ...entry.block,
                  content: entry.block.content ?? null,
                }}
              />
            );
          }

          if (entry.kind === 'pills') {
            return (
              <PillsBlock
                id={entry.id}
                title={entry.data.title}
                description={entry.data.description}
                pills={entry.data.pills}
              />
            );
          }

          return null;
        })}
      </div>
    ) : null}

    <HomeAbout />
  </div>
  <DraftModeQueryListener query={HOME_PAGE_QUERY} />
</BaseLayout>
