---
// The catalogue used to be paginated (/libri/pagina/<n>, 40 books each). It is now one faceted
// page, so every old page URL moves permanently to /libri; malformed tokens stay a 404.
const rawPage = Astro.params.page ?? '';

if (!/^[1-9][0-9]*$/.test(rawPage)) {
  return Astro.rewrite('/404');
}

return Astro.redirect('/libri', 301);
---
