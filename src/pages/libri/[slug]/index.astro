---
import { Image } from '@datocms/astro/Image';
import { StructuredText } from '@datocms/astro/StructuredText';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AlternateFormatsList from '~/components/AlternateFormatsList';
import BookCarouselSection from '~/components/BookCarouselSection';
import DetailList from '~/components/DetailList';
import AuthorsSection from '~/components/AuthorsSection';
import Button from '~/components/ui/Button';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { toPlainText, truncateToLength, decodeEntities } from '~/lib/text';
import { structuredTextToPlainText, hasStructuredTextContent } from '~/lib/datocms/structuredText';
import {
  defaultBlockComponents,
  defaultLinkToRecordComponents,
} from '~/lib/datocms/structuredTextComponents';
import {
  formatBookPrice,
  buildEditionDetails,
  buildGraphicsDetails,
  buildOrderMailto,
  ebookStoreName,
  extractYear,
  mapBooksToCards,
  normalizeText,
} from '~/lib/books';
import { coverFieldPalette } from '~/lib/colors';
import { getAuthorDisplayName, buildAuthorSegments } from '~/lib/authors';
import { withFallbackSeo } from '~/lib/seo';
import styles from './_style.module.css';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { resolveDraftMode } from '~/lib/draftPreview';
import type { TitleMetaLinkTag } from '@datocms/astro';
import {
  BOOK_DETAIL_QUERY,
  BOOK_AUTHORS_BOOKS_QUERY,
  BOOK_ALTERNATE_FORMATS_QUERY,
  BOOK_COLLECTION_BOOKS_QUERY,
  type BookDetailQueryResult,
  type BookDetailRecord,
  type BookAuthorsBooksResult,
  type BookAlternateFormatsResult,
  type BookCollectionBooksResult,
} from './_graphql';

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing book slug');
}

const draftModeEnabled = resolveDraftMode(Astro);

const detailData = await executeQuery<BookDetailQueryResult>(BOOK_DETAIL_QUERY, {
  variables: { slug },
  includeDrafts: draftModeEnabled,
});

const book = detailData.book;

if (!book) {
  return Astro.rewrite('/404');
}

const authors = book.authors ?? [];
const authorIds = authors
  .map((author) => author.id)
  .filter((id): id is string => Boolean(id && id.length > 0));

let authorsBookCounts = new Map<string, number>();

if (authorIds.length > 0) {
  const authorsData = await executeQuery<BookAuthorsBooksResult>(BOOK_AUTHORS_BOOKS_QUERY, {
    variables: { authorIds },
    includeDrafts: draftModeEnabled,
  });

  const counts = new Map<string, number>();
  const targetAuthors = new Set(authorIds);

  for (const relatedBook of authorsData.allBooks ?? []) {
    const seen = new Set<string>();
    for (const author of relatedBook.authors ?? []) {
      const authorId = author.id;
      if (!authorId || seen.has(authorId) || !targetAuthors.has(authorId)) {
        continue;
      }

      counts.set(authorId, (counts.get(authorId) ?? 0) + 1);
      seen.add(authorId);
    }
  }

  authorsBookCounts = counts;
}

const alternateFormatsData = await executeQuery<BookAlternateFormatsResult>(
  BOOK_ALTERNATE_FORMATS_QUERY,
  {
    variables: {
      title: book.title,
      excludeSlug: { neq: book.slug ?? '' },
    } as any,
    includeDrafts: draftModeEnabled,
  },
);

const authorSegments = buildAuthorSegments(authors);

const formattedPrice = formatBookPrice(book.price);
const descriptionHtml = book.description;
const reviewContent = hasStructuredTextContent(book.review) ? book.review : null;
const reviewPlain = structuredTextToPlainText(reviewContent);
const descriptionPlain = toPlainText(book.description ?? null);
const showReview = Boolean(reviewContent && reviewPlain !== descriptionPlain);
const promoText = toPlainText(book.promo);

const formatValue = normalizeText(book.format);
const isArchived = book.archive === true;
const isEbookFormat = formatValue?.toLowerCase() === 'ebook';
const printYearLabel = extractYear(book.printYear);
const authorNames = authors.map((author) => getAuthorDisplayName(author)).filter(Boolean);

// Other editions with the same title: the ebook, a newer or older print edition.
const otherEditions = (alternateFormatsData.allBooks ?? [])
  .filter((alt) => alt.slug !== book.slug)
  .map((alt) => {
    const format = normalizeText(alt.format) ?? 'Altra edizione';
    return {
      id: alt.id,
      slug: alt.slug,
      format,
      isEbook: format.toLowerCase() === 'ebook',
      price: formatBookPrice(alt.price),
      year: extractYear(alt.printYear),
      archived: alt.archive === true,
      epubUrl: alt.epubUrl,
    };
  });

// One ebook control: the book's own store link (a print book can carry it) or the ebook edition's.
const ebookEdition = isEbookFormat
  ? null
  : (otherEditions.find((edition) => edition.isEbook && edition.epubUrl && !edition.archived) ?? null);
const ebookUrl = isEbookFormat ? book.epubUrl : (book.epubUrl ?? ebookEdition?.epubUrl ?? null);
const ebookStore = ebookStoreName(ebookUrl);
const ebookLabel = ['Ebook', ebookEdition?.price ?? null, ebookStore ? `su ${ebookStore}` : null]
  .filter(Boolean)
  .join(' ');
const buyEbookLabel = ebookStore ? `Acquista l'ebook su ${ebookStore}` : "Acquista l'ebook";

// Print editions still in the catalogue, newest first. On an out-of-catalogue page the newest one
// becomes the primary action, so an old link still leads to a book that can be ordered.
const printEditions = otherEditions
  .filter((edition) => !edition.isEbook && !edition.archived)
  .sort((a, b) => Number(b.year ?? 0) - Number(a.year ?? 0));
const currentEdition = isArchived ? (printEditions[0] ?? null) : null;
const furtherEditions = (currentEdition ? printEditions.slice(1) : printEditions)
  .slice(0, 3)
  .map((edition) => ({
    id: edition.id,
    format: [edition.format, edition.year].filter(Boolean).join(' '),
    price: edition.price,
    href: `/libri/${edition.slug}`,
  }));

// There is no cart: the order is an email to ordini@, prefilled with this book.
const canOrderPrint = !isArchived && !isEbookFormat;
const orderHref = buildOrderMailto({
  title: book.title,
  authors: authorNames,
  isbn: book.isbn,
  price: formattedPrice,
});

const coverPalette = coverFieldPalette(book.coverImage?.colors);

let collectionCarouselTitle: string | null = null;
let collectionCarouselDescription: string | null = null;
let collectionCarouselLinkLabel: string | null = null;
let collectionCarouselLinkHref: string | null = null;
let collectionCarouselBooks = mapBooksToCards([]);
let collectionCarouselId: string | null = null;

if (book.collection?.id) {
  const collectionBooksData = await executeQuery<BookCollectionBooksResult>(
    BOOK_COLLECTION_BOOKS_QUERY,
    {
      variables: {
        collectionId: book.collection.id,
      },
      includeDrafts: draftModeEnabled,
    },
  );

  const collectionBooks = collectionBooksData.allBooks ?? [];
  const totalFromCollection = collectionBooks.length;
  const relatedBooks = collectionBooks.filter((related) => related.id !== book.id);

  const limitedRelated = relatedBooks.slice(0, 10);
  const mappedRelated = mapBooksToCards(limitedRelated);

  if (mappedRelated.length > 0 && book.collection?.name) {
    collectionCarouselBooks = mappedRelated;
    collectionCarouselTitle = `Dalla collana "${book.collection.name}"`;
    const baseDescription = `Ecco alcuni dei ${totalFromCollection} libri presenti nella collana`;
    if (book.collection.slug) {
      collectionCarouselDescription = baseDescription;
      collectionCarouselLinkLabel = book.collection.name;
      collectionCarouselLinkHref = `/collane/${book.collection.slug}`;
    } else {
      collectionCarouselDescription = `${baseDescription} ${book.collection.name}`;
    }
    collectionCarouselId = `collection-${book.collection.slug ?? book.collection.id}`;
  }
}

const authorsCards = authors.map((author) => {
  const name = getAuthorDisplayName(author);
  const biographyPlain = structuredTextToPlainText(author.biography);
  const biographyExcerpt = biographyPlain.length > 0 ? truncateToLength(biographyPlain, 220) : '';
  const booksCount = authorsBookCounts.get(author.id) ?? (authorIds.includes(author.id) ? 1 : 0);
  const booksLabel =
    booksCount === 1 ? '1 libro con Multimage' : `${booksCount} libri con Multimage`;

  return {
    id: author.id,
    name,
    slug: author.slug ?? null,
    biography: biographyExcerpt,
    booksLabel,
    picture: author.picture,
  };
});

// Paired forms, feminine first (the site's convention): the CMS does not record gender.
const authorsSectionTitle =
  authorsCards.length > 1 ? 'Autrici/Autori del libro' : 'Autrice/Autore del libro';

const reviewDateFormatter = new Intl.DateTimeFormat('it-IT', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

type BookReviewLink = NonNullable<BookDetailRecord['reviews']>[number];
const MIN_ABSTRACT_LENGTH = 40;
const stripUrls = (value: string) =>
  value
    .replace(/https?:\/\/\S+/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const dateToTimestamp = (value: string | null | undefined) => {
  if (!value) {
    return 0;
  }

  const timestamp = new Date(value).getTime();
  return Number.isNaN(timestamp) ? 0 : timestamp;
};

const reviewPreviews = (book.reviews ?? [])
  .filter((review): review is BookReviewLink => Boolean(review?.slug))
  .sort((a, b) => {
    const dateA = a._firstPublishedAt ?? a.createdAt ?? null;
    const dateB = b._firstPublishedAt ?? b.createdAt ?? null;
    return dateToTimestamp(dateB) - dateToTimestamp(dateA);
  })
  .map((review) => {
    // Editors sometimes paste a source URL as the abstract: links never stand in for text.
    const abstract = stripUrls(review.abstract ?? '');
    const plainBody = stripUrls(structuredTextToPlainText(review.body));
    const excerptSource = abstract.length >= MIN_ABSTRACT_LENGTH ? abstract : plainBody;
    const excerpt =
      excerptSource.length >= MIN_ABSTRACT_LENGTH ? truncateToLength(excerptSource, 300) : null;
    const dateIso = review._firstPublishedAt ?? review.createdAt ?? null;
    const dateLabel =
      dateIso && !Number.isNaN(new Date(dateIso).getTime())
        ? reviewDateFormatter.format(new Date(dateIso))
        : null;

    return {
      id: review.id,
      slug: review.slug as string,
      title: review.title ?? 'Recensione',
      excerpt,
      dateIso,
      dateLabel,
      authorName: review.author?.name?.trim() ?? null,
    };
  });

const reviewStructuredData =
  reviewPreviews.length > 0
    ? {
        '@context': 'https://schema.org',
        '@graph': reviewPreviews
          .filter((review) => review.dateIso)
          .map((review) => ({
            '@type': 'Review',
            datePublished: review.dateIso,
            name: review.title,
            ...(review.excerpt ? { reviewBody: review.excerpt } : {}),
            url: `/magazine/${review.slug}`,
            ...(review.authorName
              ? { author: { '@type': 'Person', name: review.authorName } }
              : {}),
            itemReviewed: {
              '@type': 'Book',
              name: book.title,
              ...(book.isbn ? { isbn: book.isbn } : {}),
              ...(book.slug ? { url: `/libri/${book.slug}` } : {}),
            },
            publisher: {
              '@type': 'Organization',
              name: 'Multimage',
            },
          })),
      }
    : null;

// Price and format already sit in the hero; the staff sheet (/libri/schede) keeps the full list.
const HERO_DETAIL_LABELS = new Set(['Formato', 'Prezzo di copertina']);
const editionDetails = buildEditionDetails(book).filter((item) => !HERO_DETAIL_LABELS.has(item.label));
const graphicsDetails = buildGraphicsDetails(book);
const collectionHref = book.collection?.slug ? `/collane/${book.collection.slug}` : null;

const coverResponsiveImage = book.coverImage?.responsiveImage
  ? { ...book.coverImage.responsiveImage, alt: book.coverImage.responsiveImage.alt ?? book.title }
  : null;

const fallbackDescription = toPlainText(book.promo ?? book.description);
const escapeAttr = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

const sanitizeMetaTags = (tags: TitleMetaLinkTag[]): TitleMetaLinkTag[] =>
  tags.map((tag) => {
    if (tag.tag !== 'meta' || !tag.attributes) {
      return tag;
    }

    const descriptor = (tag.attributes.name ?? tag.attributes.property ?? '')
      .toString()
      .toLowerCase();
    const rawContent =
      (typeof tag.attributes.content === 'string' && tag.attributes.content) ||
      (typeof tag.content === 'string' ? tag.content : '') ||
      '';
    const decoded = decodeEntities(rawContent);

    const isDescription =
      descriptor === 'description' ||
      descriptor === 'og:description' ||
      descriptor === 'twitter:description';

    const preparedContent = isDescription ? truncateToLength(toPlainText(decoded), 240) : decoded;
    const withoutQuotes = preparedContent.replace(/"/g, "'");
    const safeContent = escapeAttr(withoutQuotes);

    return {
      ...tag,
      attributes: {
        ...tag.attributes,
        content: safeContent,
      },
      content: null,
    };
  });

const seo = sanitizeMetaTags(
  withFallbackSeo(book.seo, {
    title: `${book.title} | Multimage`,
    description: fallbackDescription,
  }),
);
---

<BaseLayout seo={seo}>
  {reviewStructuredData ? (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(reviewStructuredData)} />
  ) : null}
  <article class={styles.article}>
    <section class={styles.hero} aria-labelledby="book-title">
      <div class={styles.heroGrid}>
        <div class={styles.coverField} style={`background: ${coverPalette.field};`}>
          {coverResponsiveImage ? (
            <Image
              data={coverResponsiveImage}
              sizes="(min-width: 768px) 340px, 50vw"
              pictureClass="block"
              imgClass={styles.cover}
              imgStyle={{ filter: `drop-shadow(24px 36px 48px ${coverPalette.shadow})` }}
              priority
            />
          ) : (
            <div class={styles.coverFallback}>Copertina in arrivo</div>
          )}
        </div>

        <div class={styles.copyField} style={`background: ${coverPalette.copy};`}>
          <div class={styles.copy}>
            <h1 id="book-title" class={styles.title}>{book.title}</h1>
            {book.subtitle ? <p class={styles.subtitle}>{book.subtitle}</p> : null}

            {authorSegments.length > 0 ? (
              <p class={styles.byline}>
                <span>{book.editedBy ? 'a cura di ' : 'di '}</span>
                {authorSegments.map((segment) =>
                  segment.type === 'text' ? (
                    <span>{segment.value}</span>
                  ) : segment.href ? (
                    <a href={segment.href}>{segment.label}</a>
                  ) : (
                    <span class="font-semibold">{segment.label}</span>
                  ),
                )}
              </p>
            ) : null}

            <p class={styles.meta}>
              {book.collection?.name ? (
                <span>
                  Collana{' '}
                  {collectionHref ? (
                    <a href={collectionHref}>{book.collection.name}</a>
                  ) : (
                    book.collection.name
                  )}
                </span>
              ) : null}
              {[printYearLabel, formatValue, isArchived ? 'Fuori catalogo' : null]
                .filter(Boolean)
                .map((part, index) => (
                  <span>
                    {index > 0 || book.collection?.name ? ' · ' : ''}
                    {part}
                  </span>
                ))}
            </p>

            {promoText ? <p class={styles.promo}>{promoText}</p> : null}

            {isArchived ? (
              <div class={styles.buy}>
                <p class={styles.status}>Questa edizione è fuori catalogo.</p>
                {currentEdition ? (
                  <p class={styles.statusNote}>
                    {currentEdition.year
                      ? `C'è un'edizione del ${currentEdition.year} che puoi ordinare.`
                      : "C'è un'altra edizione che puoi ordinare."}
                  </p>
                ) : null}
                <div class={styles.actions}>
                  {currentEdition ? (
                    <Button href={`/libri/${currentEdition.slug}`} primary icon="iconoir:arrow-right">
                      Vai alla nuova edizione
                    </Button>
                  ) : null}
                  {ebookUrl ? (
                    <Button
                      href={ebookUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      primary={!currentEdition ? true : false}
                      icon="iconoir:open-new-window"
                    >
                      {ebookLabel}
                      <span class="sr-only"> (si apre in una nuova scheda)</span>
                    </Button>
                  ) : null}
                </div>
                {!currentEdition && !ebookUrl ? (
                  <p class={styles.ways}>
                    <a href="/libri">Sfoglia il catalogo</a>
                  </p>
                ) : null}
              </div>
            ) : (
              <div class={styles.buy}>
                {formattedPrice ? <p class={styles.price}>{formattedPrice}</p> : null}
                <div class={styles.actions}>
                  {canOrderPrint ? (
                    <Button href={orderHref} primary icon="iconoir:mail" iconPosition="left">
                      Ordina via email
                    </Button>
                  ) : null}
                  {isEbookFormat && ebookUrl ? (
                    <Button
                      href={ebookUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      primary
                      icon="iconoir:open-new-window"
                    >
                      {buyEbookLabel}
                      <span class="sr-only"> (si apre in una nuova scheda)</span>
                    </Button>
                  ) : null}
                  {!isEbookFormat && ebookUrl ? (
                    <Button
                      href={ebookUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      primary={false}
                      icon="iconoir:open-new-window"
                    >
                      {ebookLabel}
                      <span class="sr-only"> (si apre in una nuova scheda)</span>
                    </Button>
                  ) : null}
                </div>
                {canOrderPrint ? (
                  <>
                    <p class={styles.terms}>
                      Spedizione gratuita con piego di libri ·{' '}
                      <span class="whitespace-nowrap"><a href="/info/adesioni">Soci</a>: 30% di sconto</span>
                    </p>
                    <p class={styles.ways}>
                      <a href="/distributori">Trovalo in libreria</a>
                      <a href="/info/ordinare">Come funziona l'ordine</a>
                    </p>
                  </>
                ) : null}
              </div>
            )}

            <AlternateFormatsList label="Altre edizioni" formats={furtherEditions} />
          </div>
        </div>
      </div>
    </section>

    <div class={styles.body}>
      {descriptionHtml ? <div class:list={[styles.prose, styles.lede]} set:html={descriptionHtml} /> : null}

      {showReview && reviewContent ? (
        <section class={styles.section} aria-labelledby="book-back-cover">
          <h2 id="book-back-cover" class={styles.sectionTitle}>Quarta di copertina</h2>
          <div class={styles.prose}>
            <StructuredText
              data={reviewContent as any}
              blockComponents={defaultBlockComponents as any}
              linkToRecordComponents={defaultLinkToRecordComponents as any}
            />
          </div>
        </section>
      ) : null}

      <AuthorsSection title={authorsSectionTitle} authors={authorsCards} />

      {editionDetails.length > 0 || graphicsDetails.length > 0 ? (
        <section class={styles.section} aria-labelledby="book-details">
          <h2 id="book-details" class={styles.sectionTitle}>Dettagli</h2>
          <div class={styles.detailsGrid}>
            {editionDetails.length > 0 ? <DetailList title="Edizione" items={editionDetails} /> : null}
            {graphicsDetails.length > 0 ? <DetailList title="Grafica" items={graphicsDetails} /> : null}
          </div>
          {draftModeEnabled ? (
            <p class={styles.staffLink}>
              <a href={`/libri/schede/${book.slug}`} target="_blank" rel="noopener noreferrer">
                Scheda libro (PDF) — staff
              </a>
            </p>
          ) : null}
        </section>
      ) : null}

      {reviewPreviews.length > 0 ? (
        <section class={styles.section} aria-labelledby="book-reviews">
          <h2 id="book-reviews" class={styles.sectionTitle}>Recensioni</h2>
          <ul class={styles.reviews}>
            {reviewPreviews.map((review) => (
              <li data-review-id={review.id} class={styles.review}>
                {review.dateLabel || review.authorName ? (
                  <p class={styles.reviewMeta}>
                    {review.dateLabel ? (
                      <time datetime={review.dateIso ?? undefined}>{review.dateLabel}</time>
                    ) : null}
                    {review.dateLabel && review.authorName ? ' · ' : null}
                    {review.authorName ? <span>a cura di {review.authorName}</span> : null}
                  </p>
                ) : null}
                <h3 class={styles.reviewTitle}>
                  <a href={`/magazine/${review.slug}`}>{review.title}</a>
                </h3>
                {review.excerpt ? <p class={styles.reviewExcerpt}>{review.excerpt}</p> : null}
              </li>
            ))}
          </ul>
        </section>
      ) : null}
    </div>

    {collectionCarouselTitle && collectionCarouselId && collectionCarouselBooks.length > 0 ? (
      <BookCarouselSection
        id={collectionCarouselId}
        title={collectionCarouselTitle}
        description={collectionCarouselDescription}
        descriptionLinkHref={collectionCarouselLinkHref ?? undefined}
        descriptionLinkLabel={collectionCarouselLinkLabel ?? undefined}
        books={collectionCarouselBooks}
      />
    ) : null}
  </article>
  <DraftModeQueryListener query={BOOK_DETAIL_QUERY} variables={{ slug }} />
  {book.collection?.id ? (
    <DraftModeQueryListener
      query={BOOK_COLLECTION_BOOKS_QUERY}
      variables={{ collectionId: book.collection.id }}
    />
  ) : null}
  {book.title ? (
    <DraftModeQueryListener
      query={BOOK_ALTERNATE_FORMATS_QUERY}
      variables={{ title: book.title, excludeSlug: { neq: book.slug ?? '' } }}
    />
  ) : null}
</BaseLayout>
