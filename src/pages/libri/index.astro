---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BooksCatalogue from '~/components/BooksCatalogue';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { toPlainText } from '~/lib/text';
import { withFallbackSeo } from '~/lib/seo';
import { extractYear } from '~/lib/books';
import { getAuthorDisplayName } from '~/lib/authors';
import {
  CATALOGUE_CHUNK,
  buildPeriodOptions,
  isTranslated,
  latestYear,
  normalizeForSearch,
  type CatalogueEntry,
  type CatalogueOption,
} from '~/lib/catalogue';
import {
  BOOKS_CATALOGUE_FACETS_QUERY,
  BOOKS_CATALOGUE_QUERY,
  CATALOGUE_PAGE_SIZE,
  type BooksCatalogueFacetsResult,
  type BooksCatalogueQueryResult,
  type CatalogueFacetRecord,
} from './index/_graphql';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { resolveDraftMode } from '~/lib/draftPreview';

const draftModeEnabled = resolveDraftMode(Astro);
// Out-of-catalogue books are skipped among the first cards: read some more than one chunk.
const firstPage = { first: CATALOGUE_PAGE_SIZE, skip: 0, cards: CATALOGUE_CHUNK + 20 };

const data = await executeQuery<BooksCatalogueQueryResult>(BOOKS_CATALOGUE_QUERY, {
  includeDrafts: draftModeEnabled,
  variables: firstPage,
});

// The CDA returns at most 500 records per query: read the rest of the catalogue, if any.
const records: CatalogueFacetRecord[] = [...(data.allBooks ?? [])];
const total = data._allBooksMeta?.count ?? records.length;
while (records.length < total) {
  const next = await executeQuery<BooksCatalogueFacetsResult>(BOOKS_CATALOGUE_FACETS_QUERY, {
    includeDrafts: draftModeEnabled,
    variables: { first: CATALOGUE_PAGE_SIZE, skip: records.length },
  });
  if (!next.allBooks?.length) break;
  records.push(...next.allBooks);
}

const entries: CatalogueEntry[] = records.map((record) => {
  const year = Number.parseInt(extractYear(record.printYear) ?? '', 10);
  const authorNames = (record.authors ?? []).map((author) => getAuthorDisplayName(author, ''));
  return {
    k: record.slug,
    c: record.collection?.slug ?? '',
    e: (record.format ?? '').trim().toLowerCase() === 'cartaceo' || !record.format ? 0 : 1,
    y: Number.isFinite(year) ? year : 0,
    a: (record.authors ?? []).map((author) => author.slug ?? '').filter(Boolean),
    t: isTranslated(record.translator, record.originalLang) ? 1 : 0,
    x: record.archive === true ? 1 : 0,
    h: record.highlight === true ? 1 : 0,
    s: normalizeForSearch(
      [record.title, record.subtitle, ...authorNames, record.collection?.name]
        .filter(Boolean)
        .join(' '),
    ),
    n: normalizeForSearch(record.title),
  };
});

// The cards the server renders: the first chunk of the default view (newest first, in catalogue).
const firstCards = (data.firstBooks ?? [])
  .filter((record) => record.archive !== true)
  .slice(0, CATALOGUE_CHUNK);

const collections: CatalogueOption[] = (data.allCollections ?? []).map((collection) => ({
  value: collection.slug,
  label: collection.name,
}));

const authorMap = new Map<string, string>();
records.forEach((record) =>
  (record.authors ?? []).forEach((author) => {
    const name = getAuthorDisplayName(author, '');
    if (author.slug && name) authorMap.set(author.slug, name);
  }),
);
const collator = new Intl.Collator('it', { sensitivity: 'base' });
const authors: CatalogueOption[] = [...authorMap]
  .map(([value, label]) => ({ value, label }))
  .sort((a, b) => collator.compare(a.label, b.label));

const newest = latestYear(entries);
const periods = buildPeriodOptions(entries.map((entry) => entry.y));

const booksIndexContent = data.booksIndexPage?.[0] ?? null;
const title = booksIndexContent?.title?.trim() || 'Libri';
const introHtml = booksIndexContent?.subtitle?.trim() || null;
const seo = withFallbackSeo(booksIndexContent?._seoMetaTags, {
  title,
  description: introHtml ? toPlainText(introHtml) : undefined,
});
---

<BaseLayout seo={seo}>
  <BooksCatalogue
    title={title}
    introHtml={introHtml}
    entries={entries}
    firstCards={firstCards}
    collections={collections}
    authors={authors}
    periods={periods}
    newest={newest}
  />
  <DraftModeQueryListener query={BOOKS_CATALOGUE_QUERY} variables={firstPage} />
</BaseLayout>
