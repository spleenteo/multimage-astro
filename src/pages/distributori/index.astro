---
// /distributori: how to get a Multimage book in person or by post. A slim title row, three ways
// (any bookshop, the bookshops and friendly places listed here, an email order to us), the list
// by region with a flat region strip, and a closing word for booksellers.
import BaseLayout from '~/layouts/BaseLayout.astro';
import SupplierCard from '~/components/SupplierCard';
import Button from '~/components/ui/Button';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { withFallbackSeo } from '~/lib/seo';
import { toPlainText } from '~/lib/text';
import { groupSuppliersByRegion, mapSuppliersToCards } from '~/lib/suppliers';
import styles from './_style.module.css';
import { SUPPLIERS_PAGE_QUERY, type SuppliersPageQueryResult } from './_graphql';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { resolveDraftMode } from '~/lib/draftPreview';

const ORDERS_EMAIL = 'ordini@multimage.org';
const draftModeEnabled = resolveDraftMode(Astro);

const data = await executeQuery<SuppliersPageQueryResult>(SUPPLIERS_PAGE_QUERY, {
  includeDrafts: draftModeEnabled,
});

const indexContent = data.suppliersIndexPage?.[0] ?? null;
const title = indexContent?.title?.trim() || 'Dove trovare i nostri libri';
// The CMS subtitle (a long block of pasted HTML) now only feeds the meta description: the page
// says the same things as the three ways below.
const seo = withFallbackSeo(indexContent?._seoMetaTags, {
  title,
  description: indexContent?.subtitle ? toPlainText(indexContent.subtitle) : undefined,
});

const suppliers = mapSuppliersToCards(data.allSuppliers);
const groups = groupSuppliersByRegion(suppliers).map((group) => ({
  ...group,
  anchorId: `regione-${group.region.normalize('NFD').replace(/[^\p{L}0-9]+/gu, '-').replace(/^-+|-+$/g, '').toLowerCase() || 'altre'}`,
}));

const sizeLine =
  suppliers.length > 0
    ? `${suppliers.length} librerie e luoghi amici · ${groups.length === 1 ? '1 regione' : `${groups.length} regioni`}`
    : null;
---

<BaseLayout seo={seo}>
  <div class={styles.page}>
    <header class={styles.intro}>
      <h1 class={styles.title}>{title}</h1>
      {sizeLine ? <p class={styles.size}>{sizeLine}</p> : null}
    </header>

    <section class={styles.ways} aria-label="Tre modi per avere i nostri libri">
      <div class={styles.way}>
        <h2 class={styles.wayTitle}>In qualsiasi libreria</h2>
        <p>
          Chiedi il libro per titolo o ISBN: ogni libreria può ordinarlo dai nostri distributori,{' '}
          <a href="https://www.libridiffusi.com/" target="_blank" rel="noopener noreferrer">Libri Diffusi<span class="sr-only"> (si apre in una nuova scheda)</span></a>{' '}
          (collegata a Fastbook) e{' '}
          <a href="http://www.terminalvideo.com/" target="_blank" rel="noopener noreferrer">Terminal Distribuzione<span class="sr-only"> (si apre in una nuova scheda)</span></a>.
        </p>
      </div>

      <div class={styles.way}>
        <h2 class={styles.wayTitle}>Nelle librerie e nei luoghi amici</h2>
        <p>
          Librerie, associazioni e volontari che espongono e promuovono i nostri libri, tutti o solo
          alcuni. Prima di andare, chiedi se il titolo che cerchi è disponibile.
        </p>
        {suppliers.length > 0 ? <p><a href="#elenco">Vai all'elenco per regione</a></p> : null}
      </div>

      <div class={styles.way}>
        <h2 class={styles.wayTitle}>Ordinalo a noi</h2>
        <p>
          Scegli il libro nel catalogo e ordinalo via email dalla sua pagina. Spedizione gratuita con
          piego di libri; <a href="/info/adesioni">soci: 30% di sconto</a>.
        </p>
        <div class={styles.wayAction}>
          <Button href="/libri" primary icon="iconoir:book" iconPosition="left">Scegli il libro</Button>
        </div>
      </div>
    </section>

    {suppliers.length === 0 ? (
      <p class={styles.empty}>
        L'elenco delle librerie e dei luoghi amici è in aggiornamento. Intanto puoi chiedere i nostri
        libri in qualsiasi libreria, o ordinarli a noi.
      </p>
    ) : (
      <section id="elenco" class={styles.list} aria-labelledby="elenco-title">
        <h2 id="elenco-title" class="sr-only">Librerie e luoghi amici per regione</h2>
        {groups.length > 1 ? (
          <nav class={styles.regions} aria-label="Regioni">
            {groups.map(({ region, anchorId }) => <a href={`#${anchorId}`}>{region}</a>)}
          </nav>
        ) : null}

        {groups.map(({ region, suppliers: items, anchorId }) => (
          <section id={anchorId} class={styles.region} aria-labelledby={`${anchorId}-title`}>
            <h2 id={`${anchorId}-title`} class={styles.regionTitle}>{region}</h2>
            <div class={styles.grid}>
              {items.map((supplier) => <SupplierCard {...supplier} />)}
            </div>
          </section>
        ))}
      </section>
    )}

    <section class={styles.booksellers} aria-labelledby="librerie-title">
      <h2 id="librerie-title" class={styles.wayTitle}>Sei una libreria?</h2>
      <p>
        Puoi ordinare tramite i distributori o direttamente a noi, senza spese di spedizione: scrivi a{' '}
        <a href={`mailto:${ORDERS_EMAIL}`}>{ORDERS_EMAIL}</a>. Allo stesso indirizzo, se vuoi entrare
        nella rete di librerie e associazioni amiche.
      </p>
    </section>
  </div>
  <DraftModeQueryListener query={SUPPLIERS_PAGE_QUERY} />
</BaseLayout>
