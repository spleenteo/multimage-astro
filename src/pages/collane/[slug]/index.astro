---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CollectionDetailHero from '~/components/CollectionDetailHero';
import BookCard from '~/components/BookCard';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { toPlainText } from '~/lib/text';
import { mapBooksToCards } from '~/lib/books';
import { withFallbackSeo } from '~/lib/seo';
import styles from './_style.module.css';
import {
  COLLECTION_DETAIL_QUERY,
  COLLECTION_RELATED_BOOKS_QUERY,
  type CollectionDetailResult,
  type CollectionRelatedBooksResult,
} from './_graphql';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { resolveDraftMode } from '~/lib/draftPreview';

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing collection slug');
}

const draftModeEnabled = resolveDraftMode(Astro);

const detailData = await executeQuery<CollectionDetailResult>(COLLECTION_DETAIL_QUERY, {
  variables: { slug },
  includeDrafts: draftModeEnabled,
});

const collection = detailData.collection;

if (!collection) {
  return Astro.rewrite('/404');
}

const relatedData = await executeQuery<CollectionRelatedBooksResult>(
  COLLECTION_RELATED_BOOKS_QUERY,
  {
    variables: { collectionId: collection.id },
    includeDrafts: draftModeEnabled,
  },
);

const collectionName = collection.name ?? 'Collana senza titolo';
const descriptionPlain = toPlainText(collection.description ?? null);
const collectionDescription = descriptionPlain.length > 0 ? descriptionPlain : null;
const booksCount = relatedData._allBooksMeta?.count ?? 0;
const archivedCount = relatedData.archivedMeta?.count ?? 0;
// Newest print year first; out-of-catalogue titles after the ones that can be ordered.
const relatedBooks = mapBooksToCards(relatedData.allBooks).sort(
  (a, b) => Number(a.isArchived) - Number(b.isArchived),
);
const hiddenBooks = Math.max(booksCount - relatedBooks.length, 0);
const seo = withFallbackSeo(collection._seoMetaTags, {
  title: `${collectionName} | Multimage`,
  description: collectionDescription ?? undefined,
});
---

<BaseLayout seo={seo}>
  <article class={styles.layout}>
    <CollectionDetailHero
      name={collectionName}
      slug={collection.slug ?? slug}
      inCatalogue={Math.max(booksCount - archivedCount, 0)}
      archived={archivedCount}
      description={collectionDescription}
      logo={collection.logo}
    />

    <section class={styles.booksSection} aria-labelledby="collection-books">
      <h2 id="collection-books" class={styles.booksTitle}>I libri della collana</h2>
      {relatedBooks.length === 0 ? (
        <p class={styles.more}>
          Questa collana non ha ancora libri. <a href="/libri">Sfoglia il catalogo</a>
        </p>
      ) : (
        <div class={styles.booksGrid}>
          {relatedBooks.map((book) => (
            <BookCard
              title={book.title}
              slug={book.slug}
              subtitle={book.subtitle}
              coverImage={book.coverImage}
              authors={book.authors}
              format={book.format}
              price={book.price}
              printYear={book.printYear}
              isArchived={book.isArchived}
              variant="catalogue"
            />
          ))}
        </div>
      )}
      {hiddenBooks > 0 ? (
        <p class={styles.more}>
          Qui ne vedi {relatedBooks.length} su {booksCount}.{' '}
          <a href={`/libri?collana=${encodeURIComponent(collection.slug ?? slug)}&archivio=1`}>
            Vedi tutti i libri della collana nel catalogo
          </a>
        </p>
      ) : null}
    </section>
  </article>
  <DraftModeQueryListener query={COLLECTION_DETAIL_QUERY} variables={{ slug }} />
  <DraftModeQueryListener
    query={COLLECTION_RELATED_BOOKS_QUERY}
    variables={{ collectionId: collection.id }}
  />
</BaseLayout>
