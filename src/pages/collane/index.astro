---
// /collane: the catalogue as the editors think it. A slim title row (as on /libri), then one shelf
// per collection, largest first, "Fuori Collana" last: each with its latest covers on a field
// tinted from the newest one, and a way into the catalogue filtered by that collection.
import BaseLayout from '~/layouts/BaseLayout.astro';
import CollectionShelf from '~/components/CollectionShelf';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { toPlainText } from '~/lib/text';
import { withFallbackSeo } from '~/lib/seo';
import { extractYear } from '~/lib/books';
import styles from './index/_style.module.css';
import {
  COLLECTIONS_PAGE_QUERY,
  buildCollectionShelvesQuery,
  type CollectionShelvesResult,
  type CollectionsQueryResult,
  type ShelfBookRecord,
} from './index/_graphql';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { resolveDraftMode } from '~/lib/draftPreview';

const COVERS_PER_SHELF = 4;
// Books without a collection: shown, but after every curated collection.
const UNCURATED_SLUG = 'fuori-collana';

const draftModeEnabled = resolveDraftMode(Astro);

const data = await executeQuery<CollectionsQueryResult>(COLLECTIONS_PAGE_QUERY, {
  includeDrafts: draftModeEnabled,
});

const indexContent = data.collectionsIndexPage?.[0] ?? null;
const title = indexContent?.title?.trim() || 'Collane';
const introHtml = indexContent?.subtitle?.trim() || null;
const seo = withFallbackSeo(indexContent?._seoMetaTags, {
  title,
  description: introHtml ? toPlainText(introHtml) : undefined,
});

const records = (data.allCollections ?? []).filter((collection) => collection.slug);
const shelvesQuery =
  records.length > 0 ? buildCollectionShelvesQuery(records.map((c) => c.id)) : null;
const shelvesData = shelvesQuery
  ? await executeQuery<CollectionShelvesResult>(shelvesQuery, { includeDrafts: draftModeEnabled })
  : {};

const count = (key: string) => (shelvesData[key] as { count: number } | undefined)?.count ?? 0;

const shelves = records
  .map((collection, index) => {
    const books = ((shelvesData[`books${index}`] as ShelfBookRecord[] | undefined) ?? []).filter(
      (book) => book.archive !== true,
    );
    const total = count(`total${index}`);
    const archived = count(`archived${index}`);
    const newest = books[0] ?? null;
    return {
      name: collection.name?.trim() || 'Collana senza titolo',
      slug: collection.slug as string,
      description: toPlainText(collection.description ?? '') || null,
      inCatalogue: Math.max(total - archived, 0),
      archived,
      latest: newest ? { title: newest.title.trim(), year: extractYear(newest.printYear) } : null,
      covers: books
        .filter((book) => book.coverImage?.responsiveImage)
        .slice(0, COVERS_PER_SHELF)
        .map((book) => ({ id: book.id, title: book.title, image: book.coverImage! })),
    };
  })
  .filter((shelf) => shelf.inCatalogue + shelf.archived > 0)
  .sort((a, b) => {
    const aLast = a.slug === UNCURATED_SLUG ? 1 : 0;
    const bLast = b.slug === UNCURATED_SLUG ? 1 : 0;
    return aLast - bLast || b.inCatalogue - a.inCatalogue || a.name.localeCompare(b.name, 'it');
  });

const booksInCatalogue = shelves.reduce((sum, shelf) => sum + shelf.inCatalogue, 0);
const sizeLine = `${shelves.length} collane · ${booksInCatalogue} libri in catalogo`;
---

<BaseLayout seo={seo}>
  <div class={styles.page}>
    <header class={styles.intro}>
      <h1 class={styles.title}>{title}</h1>
      {shelves.length > 0 ? <p class={styles.size}>{sizeLine}</p> : null}
      {introHtml ? <div class={styles.lede} set:html={introHtml} /> : null}
    </header>

    {shelves.length === 0 ? (
      <div class={styles.empty}>
        <p>Non ci sono collane da mostrare. Tutti i libri sono nel catalogo.</p>
        <a href="/libri">Sfoglia il catalogo</a>
      </div>
    ) : (
      <div class={styles.shelves}>
        {shelves.map((shelf) => (
          <CollectionShelf {...shelf} />
        ))}
      </div>
    )}
  </div>
  <DraftModeQueryListener query={COLLECTIONS_PAGE_QUERY} />
  {shelvesQuery ? <DraftModeQueryListener query={shelvesQuery} /> : null}
</BaseLayout>
