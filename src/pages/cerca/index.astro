---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { withFallbackSeo } from '~/lib/seo';
import './_search.css';

const MIN_QUERY_LENGTH = 3;
const SITE_SEARCH_ENDPOINT = 'https://site-api.datocms.com/search-results';

const siteSearchToken = import.meta.env.PUBLIC_DATOCMS_SITE_SEARCH_API_TOKEN;

if (!siteSearchToken) {
  throw new Error(
    'La variabile PUBLIC_DATOCMS_SITE_SEARCH_API_TOKEN è obbligatoria per la pagina di ricerca.',
  );
}

const searchConfig = {
  endpoint: SITE_SEARCH_ENDPOINT,
  token: siteSearchToken,
  minQueryLength: MIN_QUERY_LENGTH,
  limit: 25,
  fuzzy: true,
};

const searchScriptSrc = import.meta.env.DEV
  ? '/src/pages/cerca/search-page.client.ts'
  : '/generated/search-page.client.js';

const seo = withFallbackSeo([], {
  title: 'Cerca | Multimage',
  description:
    'Cerca libri, autrici e autori, articoli del magazine e tutte le risorse del sito Multimage interrogando direttamente l\u2019indice di DatoCMS.',
});
---

<BaseLayout seo={seo}>
  <div
    class="search-page"
    data-search-root
    data-endpoint={searchConfig.endpoint}
    data-token={searchConfig.token}
    data-min-length={String(searchConfig.minQueryLength)}
    data-limit={String(searchConfig.limit)}
    data-fuzzy={searchConfig.fuzzy ? 'true' : 'false'}
  >
    <header class="search-page__intro">
      <h1 class="search-page__title">Cerca</h1>
      <p class="search-page__lede">
        Libri, autrici e autori, articoli del magazine, collane e pagine del sito.
      </p>
    </header>

    <form class="search-page__form" role="search" method="get" action="/cerca" data-search-form>
      <label class="search-page__label" for="search-query">
        <span class="sr-only">Cerca in tutto il sito</span>
        <iconify-icon
          icon="iconoir:search"
          width="20"
          height="20"
          aria-hidden="true"
        ></iconify-icon>
        <input
          id="search-query"
          name="q"
          type="search"
          autocomplete="off"
          inputmode="search"
          placeholder="Un titolo, un nome, un argomento"
          aria-describedby="search-status"
          class="search-page__input"
          data-search-input
        />
      </label>
      <button type="submit" class="search-page__submit">Cerca</button>
    </form>

    <div class="search-page__tools">
      <fieldset class="search-filters">
        <legend class="search-filters__label">Mostra solo</legend>
        <label class="search-filters__item">
          <input type="checkbox" value="books" data-search-filter />
          <span>Libri</span>
        </label>
        <label class="search-filters__item">
          <input type="checkbox" value="authors" data-search-filter />
          <span>Autrici/Autori</span>
        </label>
        <label class="search-filters__item">
          <input type="checkbox" value="magazine" data-search-filter />
          <span>Magazine</span>
        </label>
        <label class="search-filters__item">
          <input type="checkbox" value="other" data-search-filter />
          <span>Collane e pagine</span>
        </label>
      </fieldset>
      <label class="search-exact">
        <input type="checkbox" value="exact" data-search-exact />
        <span>Solo la frase esatta</span>
      </label>
    </div>

    <p
      class="search-page__status"
      id="search-status"
      role="status"
      aria-live="polite"
      data-search-status
    >
      Scrivi almeno {MIN_QUERY_LENGTH} caratteri: un titolo, un nome, un argomento.
    </p>

    <noscript>
      <p class="search-page__status">
        La ricerca ha bisogno di JavaScript. Puoi comunque sfogliare il catalogo, le autrici e gli
        autori, le collane e il magazine qui sotto.
      </p>
    </noscript>

    <section
      class="search-results"
      aria-labelledby="search-results-title"
      data-search-results
      hidden
    >
      <h2 id="search-results-title" class="sr-only">Risultati</h2>
      <ul class="search-results__list" data-search-list></ul>
      <div class="search-results__more" data-search-more hidden>
        <button type="button" class="search-results__more-button" data-search-more-button>
          Mostra altri risultati
        </button>
      </div>
    </section>

    <nav class="search-ways" aria-label="Da dove partire" data-search-ways>
      <p class="search-ways__title">Oppure parti da qui</p>
      <ul>
        <li><a href="/libri">Il catalogo</a></li>
        <li><a href="/autori">Autrici e autori</a></li>
        <li><a href="/collane">Le collane</a></li>
        <li><a href="/magazine">Il magazine</a></li>
        <li><a href="/distributori">Dove trovare i libri</a></li>
      </ul>
    </nav>
  </div>

  <script type="module" src={searchScriptSrc} is:inline></script>
</BaseLayout>
