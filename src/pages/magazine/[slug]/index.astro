---
// A magazine article: a slim title row (h1, then category · date · byline, then the lede), the
// featured image whole, the text in a 68ch reading column, and at the end the way on: more
// articles of the same category and back to the magazine. Books appear where editors place them.
import BaseLayout from '~/layouts/BaseLayout.astro';
import { StructuredText } from '@datocms/astro/StructuredText';
import { Image } from '@datocms/astro/Image';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { hasStructuredTextContent } from '~/lib/datocms/structuredText';
import { shiftHeadings } from '~/lib/datocms/structuredTextHeadings';
import { withFallbackSeo } from '~/lib/seo';
import styles from './_style.module.css';
import reading from '../../../styles/reading.module.css';
import {
  MAGAZINE_POST_QUERY,
  MAGAZINE_RELATED_QUERY,
  type MagazinePostQueryResult,
  type MagazineRelatedResult,
} from './_graphql';
import {
  defaultBlockComponents,
  defaultInlineRecordComponents,
  defaultLinkToRecordComponents,
  defaultNodeOverrides,
} from '~/lib/datocms/structuredTextComponents';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { resolveDraftMode } from '~/lib/draftPreview';
import { toPlainText, withoutUrls } from '~/lib/text';
import { categoryHref, categoryLabel, formatPostDate, postDate } from '~/lib/magazine';

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing magazine post slug');
}

const draftModeEnabled = resolveDraftMode(Astro);

const data = await executeQuery<MagazinePostQueryResult>(MAGAZINE_POST_QUERY, {
  variables: { slug },
  includeDrafts: draftModeEnabled,
});

const post = data.blogPost;

if (!post) {
  return Astro.rewrite('/404');
}

const title = post.title?.trim() || 'Articolo';
const plainAbstract = toPlainText(post.abstract);
// The lede drops pasted source links, and disappears when it only repeats the title.
const lede = withoutUrls(plainAbstract);
const showLede =
  lede.length > 0 &&
  lede.toLowerCase().replace(/\W/g, '') !== title.toLowerCase().replace(/\W/g, '');
const publishedAt = postDate(post);
const formattedDate = formatPostDate(publishedAt);
const category = post.category ?? null;
const categoryName = categoryLabel(category, 'singular');
const categoryLink = categoryHref(category);
const authorName = post.author?.name?.trim() || null;
const heroImage = post.featuredImage?.responsiveImage ?? null;
const body = shiftHeadings(post.body);
const hasBodyContent = hasStructuredTextContent(body);

const related = category?.id
  ? (
      (
        await executeQuery<MagazineRelatedResult>(MAGAZINE_RELATED_QUERY, {
          variables: { id: post.id, category: category.id },
          includeDrafts: draftModeEnabled,
        })
      ).allBlogPosts ?? []
    ).filter((item) => item.slug && item.title)
  : [];
const relatedHeading = categoryLabel(category, 'others') ?? 'Altri articoli';
const allInCategory = categoryLabel(category, 'all');

const seo = withFallbackSeo(post._seoMetaTags, {
  title: `${title} | Multimage`,
  description: plainAbstract ? withoutUrls(plainAbstract) : undefined,
});
---

<BaseLayout seo={seo}>
  <article class={reading.page}>
    <header class={reading.intro}>
      <h1 class={reading.title}>{title}</h1>
      {categoryName || formattedDate || authorName ? (
        <p class={styles.meta}>
          {categoryName ? (
            categoryLink ? (
              <a href={categoryLink}>{categoryName}</a>
            ) : (
              <span>{categoryName}</span>
            )
          ) : null}
          {formattedDate ? <time datetime={publishedAt ?? undefined}>{formattedDate}</time> : null}
          {authorName ? <span>di {authorName}</span> : null}
        </p>
      ) : null}
      {showLede ? <p class={reading.lede}>{lede}</p> : null}
    </header>

    {heroImage ? (
      <figure class={styles.figure}>
        <Image
          data={heroImage}
          priority
          sizes="(min-width: 1024px) 56rem, 100vw"
          pictureClass="block"
          imgClass={styles.figureImage}
        />
      </figure>
    ) : null}

    <div class={reading.body}>
      {hasBodyContent && body ? (
        <div class={reading.prose}>
          <StructuredText
            data={body as any}
            blockComponents={defaultBlockComponents as any}
            inlineRecordComponents={defaultInlineRecordComponents as any}
            linkToRecordComponents={defaultLinkToRecordComponents as any}
            nodeOverrides={defaultNodeOverrides as any}
          />
        </div>
      ) : (
        <p class={reading.note}>Il testo di questo articolo sarà disponibile a breve.</p>
      )}
    </div>

    <footer class={styles.next}>
      {related.length > 0 ? (
        <section aria-labelledby="altri-articoli">
          <h2 id="altri-articoli" class={styles.nextTitle}>
            {relatedHeading}
          </h2>
          <ul class={styles.nextList}>
            {related.map((item) => {
              const date = formatPostDate(postDate(item));
              return <li>
                <a href={`/magazine/${item.slug}`}>{item.title}</a>
                {date ? <span class={styles.nextDate}>{date}</span> : null}
              </li>;
            })}
          </ul>
        </section>
      ) : null}
      <p class={styles.ways}>
        {categoryLink && allInCategory ? <a href={categoryLink}>{allInCategory}</a> : null}
        <a href="/magazine">Torna al magazine</a>
      </p>
    </footer>
  </article>
  <DraftModeQueryListener query={MAGAZINE_POST_QUERY} variables={{ slug }} />
</BaseLayout>
