---
// /diventa-socio: the membership page. Server-rendered and cached like every page, identical for
// every visitor: no cookie. Title, subtitle, text, fee tiers and the optional fee note come from
// the Membership singleton in DatoCMS. The markup contract the page script
// `_membership-page.client.ts` binds to: the root `data-socio-page`, the form `data-socio-form`,
// control ids `socio-<key>` (keys of MembershipFieldKey; the areas are checkboxes
// `name="areas"`,
// "Altro" is `#socio-areas-other`, its input `#socio-areasOther` in `data-socio-other`), error
// slots `[data-error-for="<key>"]` with id `socio-<key>-error`, the error band
// `data-socio-form-error` (+ `-text`, `-list`), the two steps `data-socio-step="1|2"` (each with
// an h2 `.socio-step__title`, the focus target), `data-socio-next` (Avanti, the submit of step 1)
// and `data-socio-back`, the send area `data-socio-send` and the failure block `data-socio-fail`
// (+ `-text`, with `data-socio-retry`), `data-socio-mailto`, the way-out box
// `data-socio-mailto-box`, the status line `data-socio-status` and the Turnstile slot
// `#socio-turnstile`. The confirmation, hidden until
// the send succeeds: `data-socio-done` (section), `data-socio-done-heading` (focus target),
// `data-socio-done-lede` and `data-socio-done-fee` (filled by the script), the steps `<ol>` with
// `data-socio-receipt-link` (mailto, subject filled by the script), the toggle
// `data-socio-pay-toggle` (radios `name="socio-pay"`, values bonifico|paypal; the script moves the
// chosen box first, no request), `data-socio-methods` holding one `data-socio-method=
// "bonifico|paypal"` box each, with `data-socio-amount` and `data-socio-causale` in every box
// (filled from the server's answer, never from the page), `data-socio-copy-iban` +
// `data-socio-copy-label`, `data-socio-paypal-link` + `data-socio-paypal-label`. Then
// `data-socio-print` and `data-socio-announce` (live region).
import { StructuredText } from '@datocms/astro/StructuredText';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button';
import FieldRows, { type TextField } from './_FieldRows.astro';
import EmptyBlock from '~/components/datocms/structuredText/blocks/EmptyBlock.astro';
import DraftModeQueryListener from '~/components/DraftModeQueryListener';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { hasStructuredTextContent } from '~/lib/datocms/structuredText';
import {
  defaultBlockComponents,
  defaultInlineRecordComponents,
  defaultLinkToRecordComponents,
} from '~/lib/datocms/structuredTextComponents';
import { resolveDraftMode } from '~/lib/draftPreview';
import { withFallbackSeo } from '~/lib/seo';
import { toCents } from '~/lib/order';
import { membershipCausale } from '~/lib/membership-request';
import { sanitizeCmsHtml, toPlainText } from '~/lib/text';
import {
  PAYMENT_ACCOUNT_HOLDER,
  PAYMENT_BANK,
  PAYMENT_BIC,
  PAYMENT_IBAN,
  PAYMENT_PAYPAL,
  PAYMENT_SWIFT_INTERMEDIARY,
  formatIban,
} from '~/lib/payment';
import {
  AREA_OTHER,
  MEMBERSHIP_ADDRESS_MAX,
  MEMBERSHIP_AREAS_OTHER_MAX,
  MEMBERSHIP_BIRTH_PLACE_MAX,
  MEMBERSHIP_CITY_MAX,
  MEMBERSHIP_CONSENT_HINT,
  MEMBERSHIP_CONSENT_LABEL,
  MEMBERSHIP_COUNTRY_MAX,
  MEMBERSHIP_EMAIL,
  MEMBERSHIP_LABELS,
  MEMBERSHIP_NAME_MAX,
  MEMBERSHIP_POSTCODE_MAX,
  MEMBERSHIP_REGION_MAX,
  membershipFeeAmount,
  membershipFeeLabel,
  PAYMENT_METHODS,
} from '~/lib/membership';
import { MEMBERSHIP_PAGE_QUERY, type MembershipPageQueryResult } from './_graphql';
import '../../styles/form.css';
import './_socio.css';

// The env value, else Cloudflare's always-pass test key in dev, else none (email fallback).
const siteKey =
  PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? '1x00000000000000000000AA' : '');

const PRIVACY_URL = 'https://www.iubenda.com/privacy-policy/47684062';
const mailtoHref = `mailto:${MEMBERSHIP_EMAIL}?subject=${encodeURIComponent('Diventa socia o socio')}`;

const draftModeEnabled = resolveDraftMode(Astro);
const { membership } = await executeQuery<MembershipPageQueryResult>(MEMBERSHIP_PAGE_QUERY, {
  includeDrafts: draftModeEnabled,
});

const pageTitle = membership?.title?.trim() || 'Diventa socia o socio';
const subtitleHtml = sanitizeCmsHtml(membership?.subtitle);
const subtitleText = toPlainText(membership?.subtitle ?? null);
// A subtitle too short to describe the page in search results gives way to a fuller sentence.
const description =
  subtitleText.length >= 50
    ? subtitleText
    : "Diventa socia o socio dell'Associazione Multimage: con la quota annuale ricevi due libri in omaggio e il 30% di sconto su tutti i nostri libri.";
const feeNote = membership?.feeNote?.trim() ?? '';
const hasContent = hasStructuredTextContent(membership?.content);
const fees = membership?.fees ?? [];
const areas = membership?.collaborationAreas ?? [];
const showForm = Boolean(membership) && fees.length > 0 && Boolean(siteKey);

const seo = withFallbackSeo(membership?._seoMetaTags, {
  title: `${pageTitle} | Multimage`,
  description,
});

// Blocks the content field allows but the page does not render: present in the query so the
// structured text finds them, drawn as nothing.
const blockComponents = {
  ...defaultBlockComponents,
  SingleInfoBlockRecord: EmptyBlock,
  NewsletterSubscriptionRecord: EmptyBlock,
  ButtonRecord: EmptyBlock,
};

const email: TextField = {
  key: 'email',
  type: 'email',
  autocomplete: 'email',
  max: 254,
  required: true,
};
const firstName: TextField = {
  key: 'firstName',
  autocomplete: 'given-name',
  max: MEMBERSHIP_NAME_MAX,
  required: true,
};
const lastName: TextField = {
  key: 'lastName',
  autocomplete: 'family-name',
  max: MEMBERSHIP_NAME_MAX,
  required: true,
};
const birthDate: TextField = {
  key: 'birthDate',
  type: 'date',
  autocomplete: 'bday',
  required: true,
  describedby: 'socio-hint-data',
};
const birthPlace: TextField = {
  key: 'birthPlace',
  autocomplete: 'off',
  max: MEMBERSHIP_BIRTH_PLACE_MAX,
  required: true,
  placeholder: 'Bologna',
  describedby: 'socio-hint-data',
};
const address1: TextField = {
  key: 'address1',
  autocomplete: 'address-line1',
  max: MEMBERSHIP_ADDRESS_MAX,
  required: true,
  placeholder: 'Via e numero civico',
};
const address2: TextField = {
  key: 'address2',
  autocomplete: 'address-line2',
  max: MEMBERSHIP_ADDRESS_MAX,
  required: false,
};
const postcode: TextField = {
  key: 'postcode',
  autocomplete: 'postal-code',
  max: MEMBERSHIP_POSTCODE_MAX,
  required: true,
  placeholder: '50123',
};
const city: TextField = {
  key: 'city',
  autocomplete: 'address-level2',
  max: MEMBERSHIP_CITY_MAX,
  required: true,
  placeholder: 'Firenze',
};
const region: TextField = {
  key: 'region',
  autocomplete: 'address-level1',
  max: MEMBERSHIP_REGION_MAX,
  required: false,
  placeholder: 'FI',
};
const country: TextField = {
  key: 'country',
  autocomplete: 'country-name',
  max: MEMBERSHIP_COUNTRY_MAX,
  required: true,
  value: 'Italia',
};

// Rows of the step-1 fields and the address fieldset: one field is full width, two a pair, so
// "Provincia (facoltativo)" sits beside the country and never wraps.
const personalRows: TextField[][] = [[email], [firstName, lastName], [birthDate, birthPlace]];
const addressRows: TextField[][] = [[address1], [address2], [postcode, city], [region, country]];
const dataHint = 'Data e luogo di nascita ci servono per iscriverti nel libro soci.';
const addressGroup = {
  legend: 'Indirizzo',
  hint: 'Ci serve per spedirti i due libri in omaggio.',
  rows: addressRows,
};
// The two figures lead the band; the support line closes it.
const bandFigures = [
  { figure: '2', unit: 'libri', text: 'in omaggio con la quota' },
  { figure: '−30%', unit: '', text: 'su tutti i nostri libri' },
];
const bandSupport = {
  figure: 'Sostieni',
  text: "un'editrice non profit che pubblica libri sulla nonviolenza e i diritti umani",
};
const textLines = (s: string | null | undefined) =>
  (s ?? '')
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter(Boolean);
const successLines = textLines(membership?.successText);
const noteLines = textLines(membership?.paymentNote).slice(1);

// Localhost-only preview of the two end states (`?anteprima=conferma|errore`): no request is
// made. On any other host the query is never read, so the HTML is the plain page (the gateway
// caches by path only). The fake code has an O, outside the code alphabet: it never matches a
// real request.
const previewAllowed =
  import.meta.env.DEV || ['localhost', '127.0.0.1'].includes(Astro.url.hostname);
const preview = previewAllowed ? Astro.url.searchParams.get('anteprima') : null;
const previewMode = preview === 'conferma' || preview === 'errore' ? preview : null;
const previewFee = fees[0];
const previewAnswer =
  previewMode === 'conferma' && previewFee
    ? JSON.stringify({
        ok: true,
        code: 'SO-000000-PROV',
        notified: true,
        fee: { label: membershipFeeLabel(previewFee), amountCents: toCents(previewFee.amount) },
        causale: membershipCausale(membership?.paymentNote, 'SO-000000-PROV', 'Ada', 'Neri'),
      })
    : undefined;
---

<BaseLayout seo={seo}>
  <div
    class="socio-layout py-8 md:py-12"
    data-socio-page
    data-socio-preview={previewMode ?? undefined}
    data-socio-preview-answer={previewAnswer}
  >
    <div class="socio-intro">
      <div class="max-w-3xl space-y-4">
        <h1 class="font-serif text-3xl text-brand-navy md:text-4xl">{pageTitle}</h1>
        {subtitleHtml ? (
          <div class="text-base text-brand-charcoal md:text-lg" set:html={subtitleHtml} />
        ) : null}
      </div>

      <ul class="socio-band" aria-label="Cosa ricevi">
        {bandFigures.map((item) => <li class="socio-band__cell">
          <span class="socio-band__figure">
            {item.figure}
            {item.unit ? <span class="socio-band__unit">{item.unit}</span> : null}
          </span>
          <span class="socio-band__text">{item.text}</span>
        </li>)}
        <li class="socio-band__support">
          <span class="socio-band__support-figure">{bandSupport.figure}</span>
          <span class="socio-band__text">{bandSupport.text}</span>
        </li>
      </ul>

      {hasContent && membership?.content ? (
        <div
          class="max-w-3xl space-y-5 text-base leading-relaxed text-brand-charcoal [&_a]:text-brand-navy [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-8 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:text-brand-navy [&_h3]:mt-6 [&_h3]:font-serif [&_h3]:text-xl [&_h3]:text-brand-navy [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6"
        >
          <StructuredText
            data={membership.content as any}
            blockComponents={blockComponents as any}
            inlineRecordComponents={defaultInlineRecordComponents as any}
            linkToRecordComponents={defaultLinkToRecordComponents as any}
          />
        </div>
      ) : null}
    </div>

    <div class="socio-side">
      {showForm ? (
        <form class="socio-panel" data-socio-form data-sitekey={siteKey} novalidate>
          <div class="order-form-error" role="alert" tabindex="-1" data-socio-form-error hidden>
            <p class="order-form-error__head">
              <svg
                class="order-form-error__icon"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7.5v5.5"></path>
                <path d="M12 16.5h.01"></path>
              </svg>
              <span data-socio-form-error-text></span>
              <span data-socio-mailto hidden>
                <a href={mailtoHref}>scrivici via email</a>
              </span>
            </p>
            <ul data-socio-form-error-list hidden></ul>
          </div>

          <section class="socio-step" data-socio-step="1" aria-labelledby="socio-step-1-title">
            <h2
              class="socio-step__title"
              id="socio-step-1-title"
              tabindex="-1"
              aria-describedby="socio-step-1-count"
            >
              I tuoi dati
            </h2>
            <p class="socio-step__count" id="socio-step-1-count">Passo 1 di 2</p>
            <p class="order-hint-line" id="socio-hint-data">{dataHint}</p>
            <FieldRows rows={personalRows} />

            <fieldset class="order-fieldset" aria-describedby="socio-hint-address">
              <legend>{addressGroup.legend}</legend>
              <p class="order-hint-line" id="socio-hint-address">{addressGroup.hint}</p>
              <FieldRows rows={addressGroup.rows} />
            </fieldset>

            <div class="order-send">
              <span data-socio-next><Button type="submit" primary>Avanti</Button></span>
            </div>
          </section>

          <section
            class="socio-step"
            data-socio-step="2"
            aria-labelledby="socio-step-2-title"
            hidden
          >
            <h2
              class="socio-step__title"
              id="socio-step-2-title"
              tabindex="-1"
              aria-describedby="socio-step-2-count"
            >
              Quota
            </h2>
            <p class="socio-step__count" id="socio-step-2-count">Passo 2 di 2</p>

            <fieldset
              class="order-fieldset"
              aria-describedby={feeNote ? 'socio-hint-fee' : undefined}
            >
              <legend>{MEMBERSHIP_LABELS.fee}</legend>
              {feeNote ? <p class="order-hint-line" id="socio-hint-fee">{feeNote}</p> : null}
              <div class="order-choices">
                {fees.map((fee) => <label class="order-choice">
                  <input type="radio" name="fee" value={fee.id} required />
                  <span class="order-choice__text">
                    <b>{fee.label}</b>
                  </span>
                  <span class="order-choice__fee">{membershipFeeAmount(fee.amount)}</span>
                </label>)}
              </div>
              <p class="order-error" id="socio-fee-error" data-error-for="fee" hidden></p>
            </fieldset>

            {areas.length > 0 ? (
              <fieldset class="order-fieldset" aria-describedby="socio-hint-areas">
                <legend>Vuoi anche darci una mano? (facoltativo)</legend>
                <p class="order-hint-line" id="socio-hint-areas">
                  Scegli come ti piacerebbe collaborare e ti scriviamo al più presto.
                </p>
                <div class="socio-areas">
                  {areas.map((area) => <label class="order-check">
                    <input type="checkbox" name="areas" value={area.id} />
                    <span class="order-check__text">{area.label}</span>
                  </label>)}
                  <label class="order-check">
                    <input type="checkbox" name="areas" id="socio-areas-other" value={AREA_OTHER} />
                    <span class="order-check__text">Altro</span>
                  </label>
                </div>
                <div class="order-field socio-areas-other" data-socio-other hidden>
                  <label for="socio-areasOther">{MEMBERSHIP_LABELS.areasOther}</label>
                  <input
                    class="order-input"
                    id="socio-areasOther"
                    name="areasOther"
                    type="text"
                    maxlength={MEMBERSHIP_AREAS_OTHER_MAX}
                  />
                  <p
                    class="order-error"
                    id="socio-areasOther-error"
                    data-error-for="areasOther"
                    hidden
                  ></p>
                </div>
                <p class="order-error" id="socio-areas-error" data-error-for="areas" hidden></p>
              </fieldset>
            ) : null}

            <div class="order-consent">
              <label class="order-check">
                <input
                  type="checkbox"
                  id="socio-consent"
                  name="consent"
                  aria-labelledby="socio-consent-label"
                  aria-describedby="socio-consent-hint"
                  required
                />
                <span class="order-check__text">
                  <span id="socio-consent-label">{MEMBERSHIP_CONSENT_LABEL}</span>
                  <span class="order-check__hint" id="socio-consent-hint">
                    {MEMBERSHIP_CONSENT_HINT}
                    <a href={PRIVACY_URL} target="_blank" rel="noopener"
                      >Informativa
                      privacy<span class="sr-only">, si apre in una nuova scheda</span></a
                    >
                  </span>
                </span>
              </label>
              <p class="order-error" id="socio-consent-error" data-error-for="consent" hidden></p>
            </div>

            <div class="order-turnstile">
              <div id="socio-turnstile" tabindex="-1" data-socio-turnstile></div>
              <p
                class="order-error"
                id="socio-turnstile-error"
                data-error-for="turnstile"
                hidden
              ></p>
            </div>

            <div class="order-send socio-step__nav" data-socio-send>
              <span data-socio-back><Button type="button" primary={false}>Indietro</Button></span>
              <Button type="submit" primary>Invia la richiesta</Button>
            </div>
            <div class="socio-fail" data-socio-fail role="alert" tabindex="-1" hidden>
              <h3>La richiesta non è partita</h3>
              <p data-socio-fail-text></p>
              <div class="socio-fail__actions">
                <span data-socio-retry><Button type="button" primary>Riprova</Button></span>
                <a href={mailtoHref}>Scrivi a {MEMBERSHIP_EMAIL}</a>
              </div>
            </div>
            <p class="order-status" aria-live="polite" data-socio-status></p>
          </section>
        </form>
      ) : (
        <section
          class="max-w-xl space-y-4 bg-brand-mist p-5 text-brand-charcoal"
          data-socio-mailto-box
        >
          <h2 class="font-serif text-2xl text-brand-navy">Scrivici a {MEMBERSHIP_EMAIL}</h2>
          <p>
            Il modulo per associarsi non è attivo in questo momento: scrivici e ti rispondiamo con i
            passi per iscriverti.
          </p>
          <span data-socio-mailto>
            <Button primary href={mailtoHref}>Scrivi a {MEMBERSHIP_EMAIL}</Button>
          </span>
        </section>
      )}
      {showForm ? (
        <section class="max-w-2xl space-y-4" data-socio-done hidden>
          <h2
            class="font-serif text-3xl text-brand-navy focus:outline-none md:text-4xl"
            tabindex="-1"
            data-socio-done-heading
          >
            Richiesta inviata, grazie
          </h2>
          {successLines.map((line) => <p>{line}</p>)}
          <p class="text-base text-brand-charcoal md:text-lg" data-socio-done-lede></p>
          <p data-socio-done-fee></p>
          <h3 class="pt-4 font-serif text-2xl text-brand-navy">Cosa succede adesso</h3>
          <ol class="socio-steps">
            <li>
              Paghi la quota con bonifico o PayPal: trovi qui sotto i dati e la causale già pronta.
            </li>
            <li>
              Mandi la ricevuta a
              <a href={`mailto:${MEMBERSHIP_EMAIL}`} data-socio-receipt-link>{MEMBERSHIP_EMAIL}</a>,
              con il codice della richiesta.
            </li>
            <li>Ricevuta la quota, ti scriviamo al più presto.</li>
          </ol>
          <fieldset class="socio-pay-toggle" data-socio-pay-toggle>
            <legend>Come preferisci pagare?</legend>
            {(Object.keys(PAYMENT_METHODS) as (keyof typeof PAYMENT_METHODS)[]).map(
              (method) => <label class="order-check">
                <input
                  type="radio"
                  name="socio-pay"
                  value={method}
                  checked={method === 'bonifico'}
                />
                <span class="order-check__text">{PAYMENT_METHODS[method]}</span>
              </label>,
            )}
          </fieldset>
          <div data-socio-methods>
            <div class="order-bank" data-socio-method="bonifico">
              <h3>Bonifico bancario</h3>
              <div class="order-bank__iban">
                <p class="order-bank__label" id="socio-iban-label">IBAN</p>
                <p class="order-bank__iban-value order-iban" aria-labelledby="socio-iban-label">
                  {formatIban(PAYMENT_IBAN)}
                </p>
                <button type="button" class="order-bank__copy" data-socio-copy-iban hidden>
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="9" y="9" width="11" height="11"></rect>
                    <path d="M5 15V4h11"></path>
                  </svg>
                  <span data-socio-copy-label>Copia l'IBAN</span>
                </button>
              </div>
              <dl>
                <div>
                  <dt>Intestato a</dt>
                  <dd>{PAYMENT_ACCOUNT_HOLDER}</dd>
                </div>
                <div>
                  <dt>Banca</dt>
                  <dd>{PAYMENT_BANK}</dd>
                </div>
                <div>
                  <dt>BIC</dt>
                  <dd>{PAYMENT_BIC}</dd>
                </div>
                <div>
                  <dt>Banca intermediaria (SWIFT)</dt>
                  <dd>{PAYMENT_SWIFT_INTERMEDIARY}</dd>
                </div>
                <div>
                  <dt>Importo</dt>
                  <dd data-socio-amount></dd>
                </div>
                <div>
                  <dt>Causale</dt>
                  <dd data-socio-causale></dd>
                </div>
              </dl>
            </div>
            <div class="order-bank" data-socio-method="paypal">
              <h3>PayPal</h3>
              <div class="order-bank__paypal">
                <p>Paga con PayPal a <b>{PAYMENT_PAYPAL}</b></p>
                <a
                  class="order-bank__paypal-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-socio-paypal-link
                  hidden
                >
                  <span data-socio-paypal-label>Paga con PayPal</span>
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M14 4h6v6"></path>
                    <path d="M20 4 10 14"></path>
                    <path d="M18 14v6H4V6h6"></path>
                  </svg>
                  <span class="sr-only"> (si apre in una nuova scheda)</span>
                </a>
              </div>
              <dl>
                <div>
                  <dt>Importo</dt>
                  <dd data-socio-amount></dd>
                </div>
                <div>
                  <dt>Causale</dt>
                  <dd data-socio-causale></dd>
                </div>
              </dl>
            </div>
          </div>
          {noteLines.map((line) => <p>{line}</p>)}
          <div class="socio-actions">
            <button type="button" class="socio-text-btn" data-socio-print>
              Stampa questa pagina
            </button>
            <a class="socio-text-btn" href="/libri"
              >Sfoglia il catalogo: da socia o socio hai il 30%</a
            >
          </div>
          <p class="sr-only" aria-live="polite" data-socio-announce></p>
