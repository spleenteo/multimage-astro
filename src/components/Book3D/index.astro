---
/**
 * Book3D: libro 3D in solo CSS (nessun JavaScript lato client).
 * Markup minimo (4 elementi), perché nel catalogo ce n'è uno per card: contenitore, libro,
 * copertina e la sola faccia laterale che la posa mostra (dorso se rotY > 0, taglio delle pagine
 * altrimenti). Ombra, riflesso e taglio superiore/inferiore sono pseudo-elementi; le misure
 * derivate dalla larghezza stanno nel CSS. Il retro non esiste: con |rotY| < 90 non si vede mai.
 * Usato da BookCard: copertina piatta con la sua ombra colorata, il libro in posa al passaggio
 * del mouse sulla card (`hoverGroup`). Aggiunte rispetto all'originale: `height` (alternativa a
 * `width`), `srcset`, `hoverGroup`, `restShadow`; con prefers-reduced-motion il libro resta piatto.
 *
 * Di base mostra la copertina piatta e frontale; al passaggio del mouse il libro
 * si anima fino alla posa data da rotY / rotX / rotZ / offsetX / offsetY, poi
 * torna a posto quando il mouse esce.
 *
 * Uso:
 *   <Book3D cover={libro.cover.url} title={libro.titolo} pages={298} />
 *   <Book3D cover="/img/nassir.jpg" title="Il viaggio di Nassir" pages={600}
 *           aspect={1.5} spineColor="#fbf3ea" accentColor="#e0705d" inkColor="#6b1b1f"
 *           rotY={-35} rotX={-5} rotZ={1.5} offsetY={8} />
 */
import { book3dView } from '~/lib/book3d';

interface Props {
  /** URL della copertina (es. l'URL dell'immagine da DatoCMS) */
  cover: string;
  /** Testo della costola */
  title: string;
  /** Numero di pagine: 20 -> libro sottile, 600 -> libro spesso (scala volutamente non realistica) */
  pages?: number;
  /** Larghezza della copertina in px (tutto il resto si scala di conseguenza) */
  width?: number;
  /** Altezza / larghezza della copertina: 1.4142 = A4, 1 = quadrata */
  aspect?: number;
  /** Colore di dorso e retro */
  spineColor?: string;
  /** Colore delle due fasce in alto e in basso sul dorso */
  accentColor?: string;
  /** Colore del testo sul dorso */
  inkColor?: string;
  /** Posa in hover (o sempre, se flatUntilHover è false) */
  rotY?: number;
  rotX?: number;
  rotZ?: number;
  offsetX?: number;
  offsetY?: number;
  /** Ingrandimento nella posa (1 = nessuno) */
  scale?: number;
  /** true: copertina piatta finché non passi il mouse. false: libro sempre in posa */
  flatUntilHover?: boolean;
  /** Testo alternativo dell'immagine (default: "Copertina: <titolo>") */
  alt?: string;
  /** Altezza della copertina in px: se presente, la larghezza si ricava da `aspect` */
  height?: number;
  /** "eager" per la copertina principale della pagina (LCP) */
  loading?: 'lazy' | 'eager';
  /** srcset dell'immagine (es. la versione 2x) */
  srcset?: string;
  /** true: la posa scatta al passaggio sull'antenato `.group` (es. tutta la card), non solo sul libro */
  hoverGroup?: boolean;
  /** Ombra della copertina piatta (es. l'ombra colorata della card); sfuma quando il libro va in posa */
  restShadow?: string;
  class?: string;
}

const {
  cover,
  title,
  flatUntilHover = true,
  alt,
  srcset,
  loading = 'lazy',
  hoverGroup = false,
  class: className = '',
  ...geometry
} = Astro.props;

// Misure, posa e faccia visibile: `~/lib/book3d` (condiviso con le card costruite nel browser).
const { style: vars, showSpine, edgeClass: edge } = book3dView({ title, ...geometry });
---

<div
  class:list={['b3d', edge, flatUntilHover && 'b3d--flat', hoverGroup && 'b3d--group', className]}
  style={vars}
>
  <div class="book">
    {showSpine ? (
      <span class="spine" aria-hidden="true">{title}</span>
    ) : (
      <span class="pages"></span>
    )}
    <img
      src={cover}
      srcset={srcset}
      alt={alt ?? `Copertina: ${title}`}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      decoding="async"
    />
  </div>
</div>

<style>
  .b3d {
    /* Misure derivate dal disegno originale (copertina larga 300 px). */
    --i: calc(var(--w) / 60);
    --band: calc(var(--w) * 0.06);
    --pd: calc(var(--d) - var(--w) * 8 / 300);
    --pose: translate(var(--ox), var(--oy)) scale(var(--sc)) var(--rot);
    position: relative;
    width: var(--w);
    height: var(--h);
    perspective: 1800px;
  }

  .book {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: var(--pose);
  }

  /* Ombra a terra */
  .b3d::after {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(var(--h) + 8px);
    width: calc(var(--w) * 0.8);
    height: 40px;
    border-radius: 50%;
    background: rgba(30, 25, 15, 0.2);
    filter: blur(16px);
    transform: translate(calc(-50% + var(--ox)), var(--oy)) scale(var(--sc, 1));
  }

  .book > *,
  .book::before,
  .book::after {
    position: absolute;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Copertina */
  img {
    left: 0;
    top: 0;
    width: var(--w);
    height: var(--h);
    object-fit: cover;
    display: block;
    border-radius: 2px 5px 5px 2px;
    transform: translateZ(calc(var(--d) / 2));
  }
  /* Riflesso sulla copertina */
  .book::after {
    content: '';
    inset: 0;
    border-radius: 2px 5px 5px 2px;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.3) 0%,
        rgba(255, 255, 255, 0.14) 2.2%,
        rgba(0, 0, 0, 0.22) 4.2%,
        rgba(0, 0, 0, 0) 8%
      ),
      linear-gradient(
        115deg,
        rgba(255, 255, 255, 0.16) 0%,
        rgba(255, 255, 255, 0) 38%,
        rgba(0, 0, 0, 0.1) 100%
      );
    transform: translateZ(calc(var(--d) / 2 + 0.1px));
  }

  /* Dorso: due fasce (gradiente), il titolo in verticale */
  .spine {
    left: calc((var(--w) - var(--d)) / 2);
    top: 0;
    width: var(--d);
    height: var(--h);
    box-sizing: border-box;
    padding: calc(var(--band) + 8px) 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    overflow: hidden;
    /* Imposta --b3d-font sul sito (es. il font dei titoli) se vuoi un carattere specifico */
    font-family: var(--b3d-font, inherit);
    font-weight: 800;
    font-size: var(--fs);
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink);
    background:
      linear-gradient(
        var(--accent) 0 var(--band),
        transparent 0 calc(100% - var(--band)),
        var(--accent) 0
      ),
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.12) 0%,
        rgba(255, 255, 255, 0.18) 35%,
        rgba(0, 0, 0, 0.05) 100%
      ),
      var(--spine);
    transform: rotateY(-90deg) translateZ(calc(var(--w) / 2));
  }

  /* Taglio delle pagine sul lato opposto al dorso */
  .pages {
    left: calc((var(--w) - var(--pd)) / 2);
    top: var(--i);
    width: var(--pd);
    height: calc(var(--h) - 2 * var(--i));
    background: repeating-linear-gradient(90deg, #f6f1e6 0 2px, #e0d9c8 2px 3px);
    box-shadow: inset 0 0 14px rgba(90, 70, 30, 0.25);
    transform: rotateY(90deg) translateZ(calc(var(--w) / 2 - var(--i)));
  }
  /* Taglio superiore o inferiore, secondo la posa */
  .book::before {
    content: '';
    left: var(--i);
    top: calc((var(--h) - var(--pd)) / 2);
    width: calc(var(--w) - 2 * var(--i));
    height: var(--pd);
  }
  .b3d--top .book::before {
    background: repeating-linear-gradient(0deg, #fbf7ee 0 2px, #e6dfce 2px 3px);
    transform: rotateX(90deg) translateZ(calc(var(--h) / 2 - var(--i)));
  }
  .b3d--bottom .book::before {
    background: repeating-linear-gradient(0deg, #d9d1be 0 2px, #c8bfa8 2px 3px);
    transform: rotateX(-90deg) translateZ(calc(var(--h) / 2 - var(--i)));
  }

  /* Modalità "piatto finché non passi il mouse" */
  .b3d--flat .book {
    transform: translate(0, 0) rotateX(0deg) rotateY(0deg) rotateZ(0deg);
    transition: transform 700ms cubic-bezier(0.22, 0.8, 0.24, 1);
  }
  .b3d--flat::after {
    opacity: 0;
    transform: translate(-50%, 0);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.22, 0.8, 0.24, 1);
  }
  .b3d--flat .book::after {
    opacity: 0;
    transition: opacity 700ms ease;
  }

  /* Da ferma, la copertina tiene la sua ombra (filter sul contenitore: il 3D dei figli resta). */
  .b3d--flat {
    filter: var(--rest-shadow, none);
    transition: filter 500ms ease;
  }
  .b3d--flat:hover,
  :global(.group:hover) .b3d--group,
  :global(.group:focus-visible) .b3d--group {
    filter: none;
  }

  :global(.group:hover) .b3d--group .book,
  :global(.group:focus-visible) .b3d--group .book,
  .b3d--flat:hover .book {
    transform: var(--pose);
    transition-duration: 900ms;
  }
  :global(.group:hover) .b3d--group::after,
  :global(.group:focus-visible) .b3d--group::after,
  .b3d--flat:hover::after {
    opacity: 1;
    transform: translate(calc(-50% + var(--ox)), var(--oy)) scale(var(--sc, 1));
    transition-duration: 900ms;
  }
  :global(.group:hover) .b3d--group .book::after,
  :global(.group:focus-visible) .b3d--group .book::after,
  .b3d--flat:hover .book::after {
    opacity: 1;
    transition-duration: 900ms;
  }

  /* Movimento ridotto: il libro resta piatto, con la sua ombra. */
  @media (prefers-reduced-motion: reduce) {
    .b3d--flat .book,
    .b3d--flat::after,
    .b3d--flat .book::after {
      transition: none;
    }
    .b3d--flat:hover .book,
    :global(.group:hover) .b3d--group .book,
    :global(.group:focus-visible) .b3d--group .book {
      transform: none;
    }
    .b3d--flat:hover::after,
    .b3d--flat:hover .book::after,
    :global(.group:hover) .b3d--group::after,
    :global(.group:hover) .b3d--group .book::after {
      opacity: 0;
    }
    .b3d--flat:hover,
    :global(.group:hover) .b3d--group {
      filter: var(--rest-shadow, none);
    }
  }
</style>
