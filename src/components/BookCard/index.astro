---
// Book card: cover on a field tinted from its own colour, then title, authors, one meta line and
// the price. Only the cover moves on hover ("Only the Book Floats"): it turns into a 3D book
// (Book3D) with its spine, in a pose of its own derived from the slug. The `catalogue` variant is the
// quieter one used in the /libri grid: lighter field, no summary, compact on phones.
// An orderable print book (an `id`, in the catalogue, with a price) gets a bag button in the top
// right corner of the field, outside the link: `bag.client.ts` shows it and adds the book.
import Book3D from '~/components/Book3D';
import { bookCardView, type BookCardInput } from '~/lib/bookCardView';
import AuthorNames from '~/components/ui/AuthorNames';
import { getAuthorDisplayName } from '~/lib/authors';
import { coverFieldPalette } from '~/lib/colors';
import { bagBookFor } from '~/lib/order';
import styles from './style.module.css';

type Props = {
  /** The record id: with it an orderable print book gets the bag button. */
  id?: string | null;
  title: string;
  slug: string;
  href?: string;
  subtitle?: string | null;
  summary?: string | null;
  format?: string | null;
  coverImage?: BookCardInput['coverImage'];
  /** Page count: the thickness of the 3D book on hover. */
  pages?: number | null;
  authors?: Array<{
    id?: string;
    fullName?: string | null;
    alias?: string | null;
  }>;
  license?: {
    name?: string | null;
    code?: string | null;
  } | null;
  price?: number | null;
  printYear?: string | null;
  collectionName?: string | null;
  className?: string;
  isArchived?: boolean | null;
  variant?: 'default' | 'catalogue';
  headingLevel?: 'h2' | 'h3';
  /** Words before the names, e.g. "con" when the page already names the author. */
  authorsPrefix?: string | null;
};

const {
  id = null,
  title,
  slug,
  href,
  subtitle,
  summary,
  format,
  coverImage,
  pages = null,
  authors = [],
  price,
  printYear = null,
  collectionName = null,
  className = '',
  isArchived = false,
  variant = 'default',
  headingLevel = 'h3',
  authorsPrefix = null,
}: Props = Astro.props;

const isCatalogue = variant === 'catalogue';
// Link, meta line, price, tinted field and the 3D book: `~/lib/bookCardView` (shared with the cards
// the catalogue builds in the browser; `fill.client.ts` mirrors this template's structure).
const view = bookCardView({
  title,
  slug,
  href,
  format,
  coverImage,
  pages,
  price,
  printYear,
  collectionName,
  isArchived,
  variant,
});
const { meta, priceLabel } = view;
const Heading = headingLevel;

const bag = id
  ? bagBookFor({
      id,
      slug,
      title,
      authors: authors.map((a) => getAuthorDisplayName(a, '')).filter(Boolean),
      archive: isArchived,
      format,
      price,
      coverUrl: coverImage?.url ?? null,
      tint: coverFieldPalette(coverImage?.colors).field,
    })
  : null;
---

<div class:list={[styles.card, className]}>
  <a href={view.href} class:list={[styles.root, isCatalogue ? styles.catalogue : null, 'group']}>
    <article class="flex h-full flex-col">
      <div class={styles.heroPanel} style={`background: ${view.backgroundColor};`}>
        {view.cover ? (
          <div class={styles.coverWrapper}>
            <Book3D
              cover={view.cover.src}
              srcset={view.cover.srcset}
              alt=""
              {...view.cover.book}
              hoverGroup
              class={styles.book}
            />
          </div>
        ) : (
          <div class={styles.coverFallback}>Copertina in arrivo</div>
        )}
      </div>

      <div class={styles.body}>
        <div class="space-y-1">
          <Heading class={styles.title}>{title}</Heading>
          {subtitle ? <p class={styles.subtitle}>{subtitle}</p> : null}
        </div>

        {authors.length > 0 ? (
          <AuthorNames authors={authors} prefix={authorsPrefix} class={styles.authors} />
        ) : null}

        {!isCatalogue && summary ? <p class={styles.summary}>{summary}</p> : null}

        {meta.length > 0 ? <p class={styles.meta}>{meta.join(' · ')}</p> : null}

        {priceLabel ? <p class={styles.price}>{priceLabel}</p> : null}
      </div>
    </article>
  </a>

  {bag ? (
    <span class={styles.bag} data-card-bag data-bag-item={JSON.stringify(bag)} hidden>
      <button
        type="button"
        class={styles.bagButton}
        aria-label={`Metti in borsa: ${title}`}
        data-card-bag-button
      >
        {/* Inline: the bag control must not wait for the Iconify CDN. */}
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 8h14l-1 13H6L5 8Z"></path>
          <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
        </svg>
      </button>
      <span class={styles.bagTip} aria-hidden="true" data-card-bag-tip>Metti in borsa</span>
    </span>
  ) : null}
</div>

<script>
  import { initCardBags } from './bag.client';
  initCardBags();
</script>
