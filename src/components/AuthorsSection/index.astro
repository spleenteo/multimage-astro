---
// The book page's authors: flat rows (portrait, name, count, short bio) under one hairline. The
// name is the link to the profile, so a screen reader hears a name, not the whole card.
import { Image } from '@datocms/astro/Image';
import type { AssetImage } from '~/lib/datocms/types';
import styles from './style.module.css';

type AuthorCard = {
  id: string;
  name: string;
  slug?: string | null;
  biography: string;
  booksLabel: string;
  picture?: AssetImage | null;
};

type Props = {
  title: string;
  authors: AuthorCard[];
};

const { title, authors }: Props = Astro.props;
---

{authors.length === 0 ? null : (
  <section class={styles.section} aria-labelledby="book-authors">
    <h2 id="book-authors" class={styles.title}>{title}</h2>
    <ul class={styles.list}>
      {authors.map((author) => {
        const picture = author.picture?.responsiveImage ?? null;
        return <li class:list={[styles.author, picture ? styles.withPortrait : null]}>
          {picture ? (
            <div class={styles.portrait}>
              <Image
                data={{ ...picture, alt: '' }}
                sizes="128px"
                pictureClass="block h-full"
                imgClass={styles.image}
              />
            </div>
          ) : null}
          <div>
            <h3 class={styles.name}>
              {author.slug ? <a href={`/autori/${author.slug}`}>{author.name}</a> : author.name}
            </h3>
            <p class={styles.books}>{author.booksLabel}</p>
            {author.biography ? <p class={styles.bio}>{author.biography}</p> : null}
          </div>
        </li>;
      })}
    </ul>
  </section>
)}
