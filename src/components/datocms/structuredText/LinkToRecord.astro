---
// A link from Structured Text to another record (book, author, collection, page, article).
import { recordPath } from '~/lib/recordUrls';

type LinkProps = {
  node: Record<string, unknown>;
  record: { __typename: string; slug?: string | null; [key: string]: unknown };
  attrs: Record<string, string>;
};

const { record, attrs } = Astro.props as LinkProps;
const href = recordPath(record.__typename, record.slug) ?? attrs?.href ?? null;
const target = attrs?.target ?? undefined;
const rel = attrs?.rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined);
const title = attrs?.title ?? undefined;
---

{href ? (
  <a
    href={href}
    target={target}
    rel={rel}
    title={title}
    class="text-brand-navy underline underline-offset-2 hover:text-brand-navy focus:text-brand-navy"
  >
    <slot />
  </a>
) : (
  <slot />
)}
