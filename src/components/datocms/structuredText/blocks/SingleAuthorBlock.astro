---
// An author placed in the text: flat, on hairlines; a small square portrait (or the initial on
// mist), the name and the way to the profile.
import { getAuthorDisplayName } from '~/lib/authors';
import styles from './SingleAuthorBlock.module.css';

type AuthorData = {
  id: string;
  fullName?: string | null;
  alias?: string | null;
  slug?: string | null;
  picture?: { url: string } | null;
};

type Props = { block: { author?: AuthorData | null } };

const author = Astro.props.block.author ?? null;
if (!author) {
  return null;
}

const name = getAuthorDisplayName(author);
const href = author.slug ? `/autori/${author.slug}` : null;
const legal = author.alias?.trim() && author.fullName?.trim() && author.fullName.trim() !== name ? author.fullName.trim() : null;
const photo = author.picture?.url ?? null;
const src = (size: number) => `${photo}?w=${size}&h=${size}&fit=crop&crop=faces&auto=format`;
---

<aside data-datocms-content-link-boundary class={styles.root} aria-label={`Autrice o autore: ${name}`}>
  {photo ? (
    <img src={src(72)} srcset={`${src(144)} 2x`} width="72" height="72" alt="" loading="lazy" decoding="async" class={styles.portrait} />
  ) : (
    <span class={styles.initial} aria-hidden="true">{name.charAt(0).toUpperCase()}</span>
  )}
  <div class={styles.copy}>
    <p class={styles.name}>{href ? <a href={href}>{name}</a> : name}</p>
    {legal ? <p class={styles.legal}>{legal}</p> : null}
    {href ? <p class={styles.ways}><a href={href}>Vedi il profilo e i suoi libri</a></p> : null}
  </div>
</aside>
