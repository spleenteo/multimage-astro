---
// A book placed in the text by the editors: flat, its whole cover on a field tinted from its own
// colours (as on the book page), title, authors, price and the way to the book. Visible on phones.
import { coverFieldPalette } from '~/lib/colors';
import { formatBookPrice } from '~/lib/books';
import { formatAuthorNames } from '~/lib/authors';
import styles from './SingleBookBlock.module.css';

type BookData = {
  id: string;
  title: string | null;
  subtitle?: string | null;
  slug?: string | null;
  price?: number | null;
  format?: string | null;
  archive?: boolean | null;
  authors?: Array<{ fullName?: string | null; alias?: string | null }> | null;
  coverImage?: {
    url: string;
    width?: number | null;
    height?: number | null;
    colors?: Array<{ hex: string }> | null;
  } | null;
};

type Props = { block: { book?: BookData | null } };

const book = Astro.props.block.book ?? null;
if (!book) {
  return null;
}

const href = book.slug ? `/libri/${book.slug}` : null;
const title = book.title ?? 'Titolo in arrivo';
const authors = formatAuthorNames(book.authors ?? [], { fallback: '' });
const isArchived = book.archive === true;
const price = isArchived ? null : formatBookPrice(book.price);
const isEbook = (book.format ?? '').trim().toLowerCase() !== 'cartaceo' && Boolean(book.format);
const palette = coverFieldPalette(book.coverImage?.colors);
const COVER_HEIGHT = 176;
const cover = book.coverImage?.url ?? null;
const ratio =
  book.coverImage?.width && book.coverImage?.height
    ? book.coverImage.width / book.coverImage.height
    : 0.68;
const src = (h: number) => `${cover}?h=${h}&fit=max&auto=format`;
---

<aside data-datocms-content-link-boundary class={styles.root} aria-label={`Il libro: ${title}`}>
  {cover ? (
    <a
      href={href}
      class={styles.field}
      style={`background: ${palette.field};`}
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={src(COVER_HEIGHT)}
        srcset={`${src(COVER_HEIGHT * 2)} 2x`}
        width={Math.round(COVER_HEIGHT * ratio)}
        height={COVER_HEIGHT}
        alt=""
        loading="lazy"
        decoding="async"
        class={styles.cover}
        style={`filter: drop-shadow(10px 16px 18px ${palette.shadow});`}
      />
    </a>
  ) : null}
  <div class={styles.copy} style={`background: ${palette.copy};`}>
    <p class={styles.title}>
      {href ? <a href={href}>{title}</a> : title}
    </p>
    {book.subtitle ? <p class={styles.subtitle}>{book.subtitle}</p> : null}
    {authors ? <p class={styles.by}>di {authors}</p> : null}
    <p class={styles.ways}>
      {price ? <span class={styles.price}>{price}</span> : null}
      {isEbook ? <span class={styles.note}>{book.format?.trim()}</span> : null}
      {isArchived ? <span class={styles.note}>Fuori catalogo</span> : null}
      {href ? (
        <a href={href}>{isArchived ? 'Vai alla scheda del libro' : 'Vai al libro e ordinalo'}</a>
      ) : null}
    </p>
  </div>
</aside>
