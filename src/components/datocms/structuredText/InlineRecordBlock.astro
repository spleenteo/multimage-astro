---
// A record placed inline in Structured Text: a plain navy link with its name, in the flow of the text.
import { getAuthorDisplayName } from '~/lib/authors';
import { recordPath } from '~/lib/recordUrls';

type Props = {
  record?: { __typename: string; [key: string]: unknown };
  block?: { __typename: string; [key: string]: unknown };
};

const item = Astro.props.record ?? Astro.props.block ?? null;
if (!item || typeof item !== 'object') {
  return null;
}

const fields = item as {
  __typename: string;
  slug?: string | null;
  title?: string | null;
  name?: string | null;
  fullName?: string | null;
  alias?: string | null;
};
const label =
  fields.__typename === 'AuthorRecord'
    ? getAuthorDisplayName(fields, '')
    : (fields.title ?? fields.name ?? '').trim();
const href = recordPath(fields.__typename, fields.slug);
---

{label ? (
  href ? (
    <a href={href} class="font-semibold text-brand-navy underline underline-offset-2 hover:text-brand-navy focus:text-brand-navy">{label}</a>
  ) : (
    <span>{label}</span>
  )
) : null}
