---
// An author in the /autori index: flat, with a small portrait (or the initial), the name as the
// only link to the profile, the legal name under an alias, country and size, the one-line bio, and
// their latest cover on a light field tinted from it, with "+n" for the other books and the way to them.
import type { AssetImage } from '~/lib/datocms/types';
import { darkenColor, hexToRgba, lightenColor, pickBaseColor } from '~/lib/colors';
import styles from './style.module.css';

type Cover = {
  url: string;
  width: number | null;
  height: number | null;
  colors?: Array<{ hex: string }> | null;
};

type Props = {
  name: string;
  slug: string;
  legalName?: string | null;
  country?: string | null;
  /** The editors' one-line bio (`one_line_bio`). */
  bio?: string | null;
  inCatalogue: number;
  archived: number;
  picture?: AssetImage | null;
  covers: Cover[];
};

const {
  name,
  slug,
  legalName = null,
  country = null,
  bio = null,
  inCatalogue,
  archived,
  picture = null,
  covers,
}: Props = Astro.props;

const plural = (count: number) => (count === 1 ? '1 libro' : `${count} libri`);
const books =
  inCatalogue > 0
    ? [plural(inCatalogue), archived > 0 ? `${archived}\u00a0fuori\u00a0catalogo` : null]
        .filter(Boolean)
        .join(' · ')
    : `${plural(archived)} fuori catalogo`;
const booksHref = `/libri?autore=${encodeURIComponent(slug)}${inCatalogue === 0 ? '&archivio=1' : ''}`;
// Country first, when the editors filled it: "Italia · 3 libri".
const sizeLine = [country?.trim() || null, books].filter(Boolean).join(' · ');
const initial = name.trim().charAt(0).toUpperCase() || '·';
// One 128px square serves the 56px portrait at 1x and 2x: a plain <img>, not the responsive
// <picture> (seven candidates per portrait were half of the page's HTML).
const portrait = picture?.responsiveImage?.src ?? null;

// A grid of hundreds: the hue stays, light (as on catalogue cards), so the covers stay the loudest.
// One cover, the latest: the other books are a number ("+4"), the size line says the total.
const latest = covers[0] ?? null;
const latestRatio = latest?.width && latest?.height ? latest.width / latest.height : 0.7;
const otherBooks = inCatalogue + archived - 1;
const base = pickBaseColor(latest?.colors);
const fieldColor = lightenColor(base, 0.55);
const shadowColor = hexToRgba(darkenColor(base, 0.55), 0.35);
const COVER_HEIGHT = 96;
const coverSrc = (url: string, height: number) => `${url}?h=${height}&fit=max&auto=format`;
---

<article class={styles.root}>
  <div class={styles.head}>
    {portrait ? (
      <div class={styles.portrait}>
        <img
          src={portrait}
          width="56"
          height="56"
          alt=""
          loading="lazy"
          decoding="async"
          class={styles.portraitImage}
        />
      </div>
    ) : (
      <div class={styles.initial} aria-hidden="true">{initial}</div>
    )}
    <div class="min-w-0">
      <h3 class={styles.name}>
        <a href={`/autori/${slug}`}>{name}</a>
      </h3>
      {legalName ? <p class={styles.legal}>{legalName}</p> : null}
      <p class={styles.size}>{sizeLine}</p>
    </div>
  </div>

  {bio ? <p class={styles.summary}>{bio}</p> : null}

  {latest ? (
    <a
      href={booksHref}
      class={styles.covers}
      style={`background: ${fieldColor};`}
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={coverSrc(latest.url, COVER_HEIGHT)}
        srcset={`${coverSrc(latest.url, COVER_HEIGHT * 2)} 2x`}
        width={Math.round(COVER_HEIGHT * latestRatio)}
        height={COVER_HEIGHT}
        alt=""
        loading="lazy"
        decoding="async"
        class={styles.cover}
        style={`filter: drop-shadow(6px 10px 12px ${shadowColor});`}
      />
      {otherBooks > 0 ? <span class={styles.more}>+{otherBooks}</span> : null}
    </a>
  ) : null}

  <p class={styles.ways}>
    <a href={booksHref}>Vedi i libri</a>
  </p>
</article>
