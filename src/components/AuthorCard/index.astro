---
// An author in the /autori index: flat, with a small portrait (or the initial), the name as the
// only link to the profile, the legal name under an alias, country and size, the one-line bio, and
// at the foot up to four small plain covers beside the way to their books.
// `fill.client.ts` writes the same values into a clone of this markup for the cards the browser
// builds: when the structure changes here, change it there.
import type { AuthorIndexItem } from '~/lib/authorIndex';
import styles from './style.module.css';

type Props = {
  author: AuthorIndexItem;
};

const { author } = Astro.props;
---

<article class={styles.root}>
  <div class={styles.head}>
    {author.p ? (
      <div class={styles.portrait}>
        <img
          src={author.p}
          width="56"
          height="56"
          alt=""
          loading="lazy"
          decoding="async"
          class={styles.portraitImage}
        />
      </div>
    ) : (
      <div class={styles.initial} aria-hidden="true">{author.i}</div>
    )}
    <div class="min-w-0">
      <h3 class={styles.name}>
        <a href={`/autori/${author.k}`}>{author.n}</a>
      </h3>
      {author.ln ? <p class={styles.legal}>{author.ln}</p> : null}
      <p class={styles.size}>{author.sz}</p>
    </div>
  </div>

  {author.b ? <p class={styles.summary}>{author.b}</p> : null}

  <div class={styles.foot}>
    {author.cv.length > 0 ? (
      <a href={author.h} class={styles.covers} tabindex="-1" aria-hidden="true">
        {author.cv.map((cover) => (
          <img
            src={cover.src}
            width={cover.width}
            height={cover.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ))}
      </a>
    ) : null}
    <a href={author.h} class={styles.ways}>Vedi i libri</a>
  </div>
</article>
