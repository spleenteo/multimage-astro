---
// A bookshop or friendly place in the /distributori list: flat, on a hairline. Name, city and
// address first, a short description (the rest behind "Continua"), then one row of actions sized
// for a thumb: directions, call, write, website. A small logo, decorative, sits to the side.
import { Image } from '@datocms/astro/Image';
import type { SupplierCardViewModel } from '~/lib/suppliers';
import { parseSupplierPhones, supplierWebsiteLabel } from '~/lib/suppliers';
import { toPlainText, truncateToLength } from '~/lib/text';
import styles from './style.module.css';

type Props = SupplierCardViewModel & {
  className?: string;
};

const { id, name, city, address, googleMapsUrl, telephone, email, website, descriptionHtml, logo, className = '' }: Props =
  Astro.props;

/** Descriptions longer than this show a short version first. */
const SHORT_DESCRIPTION = 180;

// CMS rich text may carry pasted headings: inside a card they are paragraphs.
const description = descriptionHtml
  ? descriptionHtml.replace(/<(\/?)h[1-6]([^>]*)>/gi, '<$1p$2>')
  : null;
const descriptionPlain = description ? toPlainText(description) : '';
const descriptionShort =
  descriptionPlain.length > SHORT_DESCRIPTION ? truncateToLength(descriptionPlain, SHORT_DESCRIPTION) : null;

const websiteHref = website ? (/^https?:\/\//i.test(website) ? website : `https://${website}`) : null;
const phones = parseSupplierPhones(telephone);
const place = [city, address].filter(Boolean).join(' · ');
const logoImage = logo?.responsiveImage ? { ...logo.responsiveImage, alt: '' } : null;
const NEW_TAB = ' (si apre in una nuova scheda)';
---

<article id={`luogo-${id}`} class:list={[styles.card, className]}>
  <div class={styles.text}>
    <h3 class={styles.name}>{name}</h3>
    {place ? <p class={styles.place}>{place}</p> : null}

    {description ? (
      descriptionShort ? (
        <details class={styles.more}>
          <summary>
            <span class={styles.short}>{descriptionShort}</span>
            <span class={styles.toggle}>Continua</span>
          </summary>
          <div class={styles.description} set:html={description} />
        </details>
      ) : (
        <div class={styles.description} set:html={description} />
      )
    ) : null}

    <ul class={styles.actions}>
      {googleMapsUrl ? (
        <li>
          <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer">
            Indicazioni<span class="sr-only">{` per ${name}${NEW_TAB}`}</span>
          </a>
        </li>
      ) : null}
      {phones.map((phone) => (
        <li>
          {phone.label ? <span class={styles.who}>{phone.label}</span> : null}
          {phone.href ? <a href={phone.href}>{phone.display}</a> : <span class={styles.plain}>{phone.display}</span>}
        </li>
      ))}
      {email ? (
        <li>
          <a href={`mailto:${email}`}>{email}</a>
        </li>
      ) : null}
      {websiteHref ? (
        <li>
          <a href={websiteHref} target="_blank" rel="noopener noreferrer">
            {supplierWebsiteLabel(websiteHref)}<span class="sr-only">{NEW_TAB}</span>
          </a>
        </li>
      ) : null}
    </ul>
  </div>

  {logoImage ? (
    <div class={styles.logo}>
      <Image data={logoImage} sizes="96px" pictureClass="block" imgClass={styles.logoImage} />
    </div>
  ) : null}
</article>
