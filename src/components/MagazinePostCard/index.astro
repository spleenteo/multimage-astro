---
// A magazine entry, flat: the image, the title (h2, the only link, stretched over the entry), one
// slate line "Recensione · 9 marzo 2026", and the abstract on three lines.
import { Image } from '@datocms/astro/Image';
import type { ResponsiveImage } from '~/lib/datocms/types';
import { toPlainText, truncateToLength, withoutUrls } from '~/lib/text';
import { categoryLabel, formatPostDate, type PostCategory } from '~/lib/magazine';
import styles from './style.module.css';

type Props = {
  title: string;
  slug: string;
  abstract?: string | null;
  publishedAt?: string | null;
  category?: PostCategory;
  image?: ResponsiveImage | null;
  sticky?: boolean | null;
  priority?: boolean;
};

const {
  title,
  slug,
  abstract = null,
  publishedAt = null,
  category = null,
  image = null,
  sticky = false,
  priority = false,
}: Props = Astro.props;

const href = `/magazine/${slug}`;
const plain = withoutUrls(toPlainText(abstract));
// An abstract that only repeats the title adds nothing.
const summary =
  plain && plain.toLowerCase() !== title.trim().toLowerCase() ? truncateToLength(plain, 220) : null;
const date = formatPostDate(publishedAt);
const label = categoryLabel(category, 'singular');
---

<article class={styles.root}>
  <div class={styles.media}>
    {image ? (
      <Image
        data={{ ...image, alt: '' }}
        priority={priority}
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
        srcSetCandidates={[0.5, 1, 1.5, 2]}
        pictureClass="block h-full w-full"
        imgClass={styles.image}
      />
    ) : null}
  </div>
  <h2 class={styles.title}><a href={href}>{title}</a></h2>
  {label || date || sticky ? (
    <p class={styles.meta}>
      {sticky ? <span class={styles.pinned}>In evidenza</span> : null}
      {label ? <span>{label}</span> : null}
      {date ? <time datetime={publishedAt ?? undefined}>{date}</time> : null}
    </p>
  ) : null}
  {summary ? <p class={styles.summary}>{summary}</p> : null}
</article>
