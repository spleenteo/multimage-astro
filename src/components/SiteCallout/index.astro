---
// Thin announcement bar above the whole site, from the `app` singleton (callout_text +
// callout_background). Renders nothing when the text is empty. The WYSIWYG HTML goes through the
// allowlist sanitizer; the text colour follows the background's luminance to keep the contrast.
// A small line-drawn sprout (currentColor) grows once beside the text.
import { sanitizeCmsHtml } from '~/lib/text';

interface Props {
  text: string | null | undefined;
  background: { red: number; green: number; blue: number } | null | undefined;
}

const { text, background } = Astro.props;
const html = sanitizeCmsHtml(text);

function toLinear(channel: number) {
  const c = channel / 255;
  return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
}

const bg = background ?? { red: 250, green: 162, blue: 4 };
const luminance =
  0.2126 * toLinear(bg.red) + 0.7152 * toLinear(bg.green) + 0.0722 * toLinear(bg.blue);
// Contrast against black vs white: pick the higher one.
const darkText = (luminance + 0.05) / 0.05 >= 1.05 / (luminance + 0.05);
const style = `background-color: rgb(${bg.red} ${bg.green} ${bg.blue}); color: ${darkText ? '#111' : '#fff'};`;
---

{
  html ? (
    <div class="site-callout" style={style} data-datocms-noindex>
      <div class="site-callout__row container py-1 text-center text-[11px] leading-tight md:text-xs">
        <svg class="site-callout__sprout" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M8 15V7.5" />
          <path d="M8 10C5.2 10 3 8 3 5c2.8 0 5 2 5 5" />
          <path d="M8 7.5C8 4.6 10.2 2.5 13 2.5c0 2.9-2.2 5-5 5" />
        </svg>
        <div set:html={html} />
      </div>
    </div>
  ) : null
}

<style>
  /* global.css sizes every <p> (1rem, 1.125rem from md): the bar keeps its own small size. */
  .site-callout :global(p) {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }
  .site-callout :global(strong) {
    color: inherit;
  }
  .site-callout :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .site-callout :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .site-callout :global(a:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .site-callout__row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }

  /* A sprout drawn in line, growing once on load: stem first, then the two leaves. */
  .site-callout__sprout {
    width: 1.4em;
    height: 1.4em;
    flex: none;
  }
  .site-callout__sprout path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 24;
    animation: site-callout-sprout 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.4s 1 backwards;
  }
  .site-callout__sprout path:nth-child(2) {
    animation-delay: 0.9s;
  }
  .site-callout__sprout path:nth-child(3) {
    animation-delay: 1.15s;
  }
  @keyframes site-callout-sprout {
    from {
      stroke-dashoffset: 24;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-callout__sprout path {
      animation: none;
    }
  }
</style>
