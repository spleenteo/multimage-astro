{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Trial deploy of the Astro app on Cloudflare Workers (branch chore/cloudflare).
  // Build with DEPLOY_TARGET=cloudflare so astro.config.mjs picks @astrojs/cloudflare.
  "name": "multimage-astro",
  "account_id": "59fd5121a90b86d19e5a982e6fc41696",
  // Gateway entry (src/worker.ts): draft bypass and cache key, then forwards to Backend.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS" },
  "workers_dev": true,
  "preview_urls": true,
  // Production hostnames, attached as Worker Custom Domains (zone multimage.org, account Multimage).
  // The apex redirects to www through a Redirect Rule (see docs/guidelines/cloudflare-switch.md).
  "routes": [
    { "pattern": "www.multimage.org", "custom_domain": true },
    { "pattern": "multimage.org", "custom_domain": true },
  ],
  // Workers Cache on for the Worker; the default entrypoint turns it off below.
  "cache": { "enabled": true },
  "exports": {
    // Gateway: caching off, so it always runs and decides bypass/cache key.
    "default": { "type": "worker", "cache": { "enabled": false } },
    // Backend: the cache sits in front of it, every render and purge runs here.
    "Backend": { "type": "worker", "cache": { "enabled": true } },
  },
  "observability": { "enabled": true },
}
