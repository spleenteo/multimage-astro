{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Trial deploy of the Astro app on Cloudflare Workers (branch chore/cloudflare).
  // Build with DEPLOY_TARGET=cloudflare so astro.config.mjs picks @astrojs/cloudflare.
  "name": "multimage-astro",
  "account_id": "59fd5121a90b86d19e5a982e6fc41696",
  // Gateway entry (src/worker.ts): draft bypass and cache key, then forwards to Backend.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS" },
  "workers_dev": true,
  "preview_urls": true,
  // Production hostnames, attached as Worker Custom Domains (zone multimage.org, account Multimage).
  // The apex redirects to www through a Redirect Rule (see docs/guidelines/cloudflare-switch.md).
  "routes": [
    { "pattern": "www.multimage.org", "custom_domain": true },
    { "pattern": "multimage.org", "custom_domain": true },
  ],
  // Workers Cache on for the Worker; the default entrypoint turns it off below.
  "cache": { "enabled": true },
  "exports": {
    // Gateway: caching off, so it always runs and decides bypass/cache key.
    "default": { "type": "worker", "cache": { "enabled": false } },
    // Backend: the cache sits in front of it, every render and purge runs here.
    "Backend": { "type": "worker", "cache": { "enabled": true } },
  },
  "observability": { "enabled": true },
  // Orders store, shared with the staff app (contract: d1/README.md).
  // PLACEHOLDER: replaced with the real id from `wrangler d1 create` before the merge; never leave it empty.
  "d1_databases": [
    {
      "binding": "ORDERS",
      "database_name": "multimage-orders",
      "database_id": "70d0fa72-96c4-4ec5-b618-ebb5c4da3295",
      "migrations_dir": "d1/migrations",
    },
  ],
  // Order notification to the shop, sent only from the Email Routing subdomain address.
  // Bag counters (add, start, emptied, order): aggregate events, no visitor id. See src/lib/bag-events.ts.
  // Daily Site Search reindex (src/worker.ts `scheduled`), 02:00 UTC: 03:00 in Italy in winter, 04:00 in summer.
  "triggers": { "crons": ["0 2 * * *"] },
  "analytics_engine_datasets": [{ "binding": "BAG_EVENTS", "dataset": "multimage_bag_events" }],
  "send_email": [
    {
      "name": "ORDER_MAIL",
      "destination_address": "ordini@multimage.org",
      "allowed_sender_addresses": ["sito@ordini.multimage.org"],
    },
  ],
}
