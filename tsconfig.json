{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "~/components/*": ["./src/components/*"],
      "~/layouts/*": ["./src/layouts/*"],
      "~/lib/*": ["./src/lib/*"],
      "~/pages/*": ["./src/pages/*"],
      "~/schema": ["./schema"]
    },
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  },
  "exclude": ["tmp-next", "tmp-sample", "node_modules", "dist", "public/generated", "src/worker.ts"]
}
