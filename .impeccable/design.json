  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action of a block, e.g. \"Scopri il libro\".",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Scopri il libro</a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:8px 20px;border-radius:0;background:var(--color-brand-orange-deep,#b84f00);color:#fff;font-family:Inter,system-ui,sans-serif;font-size:.875rem;line-height:1.25rem;font-weight:600;text-transform:uppercase;letter-spacing:0;text-decoration:none;box-shadow:0 18px 45px rgba(0,72,129,.08);transition:background-color .15s,color .15s}.ds-btn-primary:hover{background:var(--color-brand-crimson,#ae0e0e);color:#fff}.ds-btn-primary:focus-visible{outline:3px solid var(--focus-ring,#004881);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Second action beside the primary, optional trailing icon.",
      "html": "<a class=\"ds-btn-secondary\" href=\"#\">Ordinalo via email <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M7 9l5 3.5L17 9\"/><path d=\"M2 17V7a2 2 0 012-2h16a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2z\"/></svg></a>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:8px 20px;border-radius:0;background:var(--color-brand-mist,#f2f4f6);color:var(--color-brand-navy,#004881);font-family:Inter,system-ui,sans-serif;font-size:.875rem;line-height:1.25rem;font-weight:600;text-transform:uppercase;text-decoration:none;box-shadow:0 18px 45px rgba(0,72,129,.08);transition:background-color .15s}.ds-btn-secondary:hover{background:rgba(242,244,246,.8)}.ds-btn-secondary:focus-visible{outline:3px solid var(--focus-ring,#004881);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis action with no fill.",
      "html": "<button class=\"ds-btn-ghost\" type=\"button\">Mostra altri</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 20px;border:0;border-radius:0;background:transparent;color:var(--color-brand-navy,#004881);font-family:Inter,system-ui,sans-serif;font-size:.875rem;font-weight:600;text-transform:uppercase;cursor:pointer;transition:background-color .15s}.ds-btn-ghost:hover{background:rgba(242,244,246,.7)}.ds-btn-ghost:focus-visible{outline:3px solid var(--focus-ring,#004881);outline-offset:2px}"
    },
    {
      "name": "Home Door",
      "kind": "nav",
      "refersTo": "home-door",
      "description": "Equal white wayfinding cells divided by mist hairlines (Catalogo, Autori, Collane).",
      "html": "<nav class=\"ds-doors\" aria-label=\"Esplora i libri\"><a class=\"ds-door\" href=\"#\"><span><span class=\"ds-door-title\">Catalogo</span><span class=\"ds-door-text\">Tutti i libri disponibili</span></span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M3 12h18m-8.5-8.5L21 12l-8.5 8.5\"/></svg></a><a class=\"ds-door\" href=\"#\"><span><span class=\"ds-door-title\">Collane</span><span class=\"ds-door-text\">I libri raccolti per tema</span></span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M3 12h18m-8.5-8.5L21 12l-8.5 8.5\"/></svg></a></nav>",
      "css": ".ds-doors{display:grid;grid-template-columns:1fr 1fr;background:#fff;border-bottom:1px solid #f2f4f6}.ds-door+.ds-door{border-left:1px solid #f2f4f6}.ds-door{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:44px;padding:32px;color:#343434;text-decoration:none;transition:background-color .15s}.ds-door>span{display:flex;flex-direction:column;gap:4px}.ds-door-title{font-family:'Playfair Display',serif;font-size:1.5rem;line-height:2rem;font-weight:600;color:#004881}.ds-door-text{font-family:Inter,system-ui,sans-serif;font-size:.875rem}.ds-door svg{color:#004881;flex-shrink:0;transition:transform .15s}.ds-door:hover{background:#f2f4f6}.ds-door:hover .ds-door-title{text-decoration:underline}.ds-door:hover svg{transform:translateX(4px)}.ds-door:focus-visible{outline:3px solid #004881;outline-offset:-4px}"
    },
    {
      "name": "Book Cover Field",
      "kind": "custom",
      "refersTo": "",
      "description": "Signature: a book on a field tinted from its own cover, tilted, with a same-hue drop shadow. Tints are computed per cover at build time; this sample uses an orange cover.",
      "html": "<section class=\"ds-coverband\"><div class=\"ds-cb-copy\"><h2 class=\"ds-cb-title\">Combattenti per la pace</h2><p class=\"ds-cb-by\">di <a href=\"#\">Daniela Bezzi</a></p><p class=\"ds-cb-price\"><span>12,00 €</span> spedizione con piego di libri gratuita</p><a class=\"ds-btn-primary\" href=\"#\">Scopri il libro</a></div><div class=\"ds-cb-field\"><div class=\"ds-cb-cover\"></div></div></section>",
      "css": ".ds-coverband{display:grid;grid-template-columns:1fr 1fr}.ds-cb-copy{background:#fef4e6;padding:48px 32px;font-family:Inter,system-ui,sans-serif;color:#343434}.ds-cb-title{margin:0;font-family:'Playfair Display',serif;font-weight:600;font-size:2.25rem;line-height:1;color:#004881}.ds-cb-by a{color:#004881;font-weight:600;text-decoration:underline;text-underline-offset:2px}.ds-cb-price span{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:600;color:#004881;margin-right:8px}.ds-cb-field{background:#f5a334;display:flex;align-items:center;justify-content:center;padding:48px 24px}.ds-cb-cover{width:120px;height:176px;background:#3b2414;transform:rotate(4deg);filter:drop-shadow(24px 36px 48px rgba(104,51,0,.45))}.ds-btn-primary{display:inline-flex;align-items:center;min-height:44px;padding:8px 20px;background:#b84f00;color:#fff;font-size:.875rem;font-weight:600;text-transform:uppercase;text-decoration:none}.ds-btn-primary:hover{background:#ae0e0e}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "header-nav-tab",
      "description": "Main tabs on the navy band; square, translucent white hairline, white focus ring.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-tab\" href=\"#\">Libri</a><a class=\"ds-nav-tab\" href=\"#\">Autrici/Autori</a><a class=\"ds-nav-tab\" href=\"#\">Distributori</a></nav>",
      "css": ".ds-nav{display:flex;gap:16px;justify-content:flex-end;padding:12px 24px;background:var(--color-brand-navy,#004881);--focus-ring:#fff}.ds-nav-tab{display:inline-flex;align-items:center;padding:8px 16px;border:1px solid rgba(255,255,255,.1);border-radius:0;color:#fff;font-family:Inter,system-ui,sans-serif;font-size:.875rem;font-weight:600;text-transform:uppercase;letter-spacing:.12em;text-decoration:none;transition:background-color .15s}.ds-nav-tab:hover{background:rgba(0,81,146,.8);color:#fff}.ds-nav-tab:focus-visible{outline:3px solid #fff;outline-offset:2px;color:#fff}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "",
      "description": "Header search on the deep navy band: translucent white field, square, solid navy submit.",
      "html": "<form class=\"ds-search\" role=\"search\"><input class=\"ds-search-input\" type=\"search\" placeholder=\"Cerca libri, autori...\" aria-label=\"Cerca\"><button class=\"ds-search-btn\" type=\"submit\">Cerca</button></form>",
      "css": ".ds-search{display:flex;align-items:center;background:rgba(255,255,255,.1);padding:4px 4px 4px 16px;--focus-ring:#fff}.ds-search{background-color:#005192}.ds-search-input{background:transparent;border:0;color:#fff;font:400 .875rem Inter,system-ui,sans-serif;padding:8px}.ds-search-input::placeholder{color:rgba(255,255,255,.8)}.ds-search-input:focus-visible{outline:3px solid #fff;outline-offset:0}.ds-search-btn{background:#004881;min-height:36px;border:0;border-radius:0;color:#fff;font:600 .75rem Inter,system-ui,sans-serif;text-transform:uppercase;padding:8px 16px;cursor:pointer}.ds-search-btn:hover{background:rgba(0,72,129,.8)}.ds-search-btn:focus-visible{outline:3px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Outlined Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary-outline",
      "description": "White secondary with a faint navy ring; \"Mostra altri n\" and empty-state actions (no lift on mist).",
      "html": "<button class=\"ds-btn-outline\" type=\"button\">Mostra altri 40</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 20px;border:0;border-radius:0;background:#fff;color:var(--color-brand-navy,#004881);box-shadow:0 0 0 1px rgba(0,72,129,.15),0 18px 45px rgba(0,72,129,.08);font:600 .875rem/1.25rem Inter,system-ui,sans-serif;text-transform:uppercase;cursor:pointer;transition:background-color .15s,color .15s}.ds-btn-outline:hover{background:#004881;color:#fff}.ds-btn-outline:focus-visible{outline:3px solid var(--focus-ring,#004881);outline-offset:2px}"
    },
    {
      "name": "Navy Utility Button",
      "kind": "button",
      "refersTo": "button-navy",
      "description": "Solid navy control that is not the primary action, e.g. the catalogue's mobile \"Filtri\" toggle.",
      "html": "<button class=\"ds-btn-navy\" type=\"button\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M7 12h10M10 17h4\"/></svg>Filtri (2)</button>",
      "css": ".ds-btn-navy{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border:0;border-radius:0;background:#004881;color:#fff;font:600 .875rem/1.25rem Inter,system-ui,sans-serif;text-transform:uppercase;cursor:pointer;transition:background-color .15s}.ds-btn-navy:hover{background:#005192}.ds-btn-navy:focus-visible{outline:3px solid var(--focus-ring,#004881);outline-offset:2px}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Active catalogue filter; the whole chip removes it.",
      "html": "<button class=\"ds-chip\" type=\"button\" aria-label=\"Togli il filtro Ebook\"><span>Ebook</span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:0 12px;border:0;border-radius:0;background:#f2f4f6;color:#004881;font:400 .875rem Inter,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,color .15s}.ds-chip:hover{background:#004881;color:#fff}.ds-chip:focus-visible{outline:3px solid var(--focus-ring,#004881);outline-offset:2px}"
    },
    {
      "name": "Facet Group",
      "kind": "input",
      "refersTo": "text-field",
      "description": "A facet fieldset: navy legend, navy-tinted native checkboxes, slate tabular counts; zero-count options grey out.",
      "html": "<fieldset class=\"ds-facet\"><legend>Formato</legend><label class=\"ds-opt\"><input type=\"radio\" name=\"f\" checked><span>Tutti i formati</span><span class=\"ds-count\">312</span></label><label class=\"ds-opt\"><input type=\"radio\" name=\"f\"><span>Cartaceo</span><span class=\"ds-count\">287</span></label><label class=\"ds-opt\" data-zero><input type=\"radio\" name=\"f\"><span>Audiolibro</span><span class=\"ds-count\">0</span></label></fieldset>",
      "css": ".ds-facet{border:0;border-top:1px solid rgba(0,72,129,.1);margin:0;padding:16px 0;font-family:Inter,system-ui,sans-serif;width:240px}.ds-facet legend{float:left;width:100%;margin-bottom:8px;font-size:.875rem;font-weight:600;color:#004881}.ds-facet legend+*{clear:both}.ds-opt{display:flex;align-items:center;gap:12px;min-height:44px;font-size:.875rem;color:#343434;cursor:pointer}.ds-opt input{width:18px;height:18px;margin:0;accent-color:#004881}.ds-opt span:first-of-type{flex:1}.ds-opt:hover span:first-of-type{color:#004881;text-decoration:underline;text-underline-offset:2px}.ds-opt:has(input:checked) span:first-of-type{font-weight:600;color:#004881}.ds-opt[data-zero]:not(:has(input:checked)) span:first-of-type{color:#6c757d}.ds-count{font-size:.75rem;color:#6c757d;font-variant-numeric:tabular-nums}.ds-opt input:focus-visible{outline:3px solid #004881;outline-offset:2px}"
    },
    {
      "name": "Book Section Tabs",
